<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>OsQarek Lavalink</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        :root { color-scheme: dark light; }
        body {
            margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            background: #0b0b14; color: #e7e5ff;
        }
        .card { text-align: center; padding: 32px 40px; border: 1px solid #2a2750; border-radius: 16px; background: rgba(20,18,48,0.5); }
        .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; vertical-align: 1px;
            background: <%= up ? '#57F287' : '#ED4245' %>; box-shadow: 0 0 10px <%= up ? '#57F287' : '#ED4245' %>; }
        h1 { font-size: 20px; margin: 0 0 6px; font-weight: 600; }
        p { margin: 4px 0 0; color: #a79fe0; font-size: 13px; }
        code { color: #c9c2ff; }
    </style>
</head>
<body>
    <div class="card">
        <h1><span class="dot"></span>Lavalink audio node is <%= up ? 'online' : 'unreachable' %></h1>
        <p>Public status page only — no dashboard or API is exposed here.</p>
        <% if (up && version) { %><p>Version <code><%= version %></code></p><% } %>
    </div>
</body>
</html>
