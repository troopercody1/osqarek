<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Moderator Application — <%= application.username %></title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', sans-serif; background-color: #16161e; color: #a9b1d6; padding: 40px 20px; }
        .page { max-width: 720px; margin: 0 auto; }

        a.back { color: #7aa2f7; text-decoration: none; font-size: 13px; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px; }
        a.back:hover { color: #a9c5ff; }

        h1 { color: #7aa2f7; font-size: 22px; font-weight: 600; margin-bottom: 20px; }

        .app-meta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }
        .app-meta .stat { background: #1a1b26; border: 1px solid #2f3549; border-radius: 10px; padding: 12px 16px; flex: 1; min-width: 140px; }
        .app-meta .label { display: block; color: #565f89; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
        .app-meta .value { color: #c0caf5; font-weight: 600; font-size: 15px; }

        .card { background: #1a1b26; border: 1px solid #2f3549; border-radius: 12px; padding: 4px 20px; }

        .qa-block { padding: 18px 0; border-bottom: 1px solid #2f3549; }
        .qa-block:last-child { border-bottom: none; }
        .qa-question { color: #7dcfff; font-size: 13px; font-weight: 600; margin-bottom: 8px; }
        .qa-answer { color: #a9b1d6; line-height: 1.6; white-space: pre-wrap; font-size: 14px; }
        .qa-answer.mc {
            display: inline-block; padding: 4px 12px; border-radius: 6px;
            background: #1a2e1a; color: #9ece6a; font-weight: 700; font-size: 13px;
        }
        .qa-answer.mc.incorrect { background: #2e1a1a; color: #f7768e; }
        .qa-grade-tag {
            display: inline-block; margin-left: 8px; font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.03em;
        }
        .qa-grade-tag.correct { color: #9ece6a; }
        .qa-grade-tag.incorrect { color: #f7768e; }
        .header-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
        .header-row h1 { margin-bottom: 0; }
        .btn-danger-outline { background: transparent; color: #f7768e; border: 1px solid #4a1c1c; padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; }
        .btn-danger-outline:hover { background: rgba(247,118,142,0.1); }
        .status-badge { display: inline-block; padding: 4px 12px; border-radius: 99px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }
        .status-badge.pending { background: #2e2a1a; color: #e0af68; }
        .status-badge.passed { background: #1a2e1a; color: #9ece6a; }
        .status-badge.failed { background: #2e1a1a; color: #f7768e; }
        .decision-row { display: flex; gap: 10px; margin-bottom: 24px; }
        .btn-pass, .btn-fail { padding: 9px 18px; border-radius: 8px; font-size: 13.5px; font-weight: 700; border: none; cursor: pointer; font-family: inherit; }
        .btn-pass { background: #1a2e1a; color: #9ece6a; } .btn-pass:hover { background: #234023; }
        .btn-fail { background: #2e1a1a; color: #f7768e; } .btn-fail:hover { background: #402323; }
        .qa-answer.pills { display: flex; gap: 6px; flex-wrap: wrap; }
        .pill { padding: 4px 12px; border-radius: 6px; background: #1f2335; color: #7dcfff; font-weight: 700; font-size: 13px; }

        /* ───── Decision summary + reason (shown on screen AND in print) ───── */
        .decision-summary { border: 1px solid #292e42; border-radius: 12px; padding: 16px 20px; margin-bottom: 20px; background: #1a1b26; }
        .decision-summary .decision-label { font-size: 22px; font-weight: 800; letter-spacing: 0.06em; }
        .decision-summary.pending { border-color: #4a4020; } .decision-summary.pending .decision-label { color: #e0af68; }
        .decision-summary.passed  { border-color: #2c4a2c; background: #14211a; } .decision-summary.passed .decision-label { color: #9ece6a; }
        .decision-summary.failed  { border-color: #4a2c2c; background: #211416; } .decision-summary.failed .decision-label { color: #f7768e; }
        .decision-summary .decision-reason { margin-top: 10px; color: #c0caf5; font-size: 14px; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
        .decision-summary .decision-reason span { display: block; color: #565f89; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 3px; }
        .decision-summary .decision-meta { margin-top: 8px; color: #565f89; font-size: 12px; }

        .decision-form { margin-bottom: 24px; }
        .decision-form label { display: block; color: #a9b1d6; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
        .decision-form label span { color: #565f89; font-weight: 400; }
        .decision-form textarea {
            width: 100%; min-height: 80px; resize: vertical; box-sizing: border-box;
            background: #1a1b26; border: 1px solid #292e42; border-radius: 8px;
            color: #c0caf5; font-family: inherit; font-size: 14px; padding: 10px 12px; margin-bottom: 10px;
        }
        .decision-form textarea:focus { outline: none; border-color: #7aa2f7; }

        .header-actions { display: flex; gap: 8px; align-items: center; }
        .header-actions form { margin: 0; }
        .btn-print {
            background: #1f2335; color: #7aa2f7; border: 1px solid #292e42;
            padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
            cursor: pointer; font-family: inherit;
        }
        .btn-print:hover { background: #24283b; }

        .app-meta .stat .value { word-wrap: break-word; overflow-wrap: anywhere; word-break: break-word; min-width: 0; }
        .print-only { display: none; }

        /* ───── Print: clean white document (screen view stays dark) ───── */
        @page { margin: 14mm; }
        @media print {
            html, body {
                background: #fff !important; color: #111 !important;
                -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important;
            }
            body { padding: 0 !important; }
            .no-print, .back, .header-actions, .decision-form,
            .mark-btn, .mark-saved-flash, .status-badge { display: none !important; }
            .print-only { display: block !important; }
            .page { max-width: 100% !important; padding: 0 !important; margin: 0 !important; }

            .print-header { color: #555; font-size: 11px; margin-bottom: 12px; padding-bottom: 6px; border-bottom: 1px solid #bbb; }
            .print-header strong { color: #111; }
            h1 { color: #111 !important; font-size: 22px; margin-bottom: 14px !important; }
            .header-row { margin-bottom: 4px; }

            .decision-summary, .decision-summary.pending, .decision-summary.passed, .decision-summary.failed {
                background: #fff !important; border: 2px solid #111 !important; border-radius: 6px; margin-bottom: 16px;
            }
            .decision-summary .decision-label { color: #111 !important; }
            .decision-summary.passed  { border-color: #1a7f37 !important; } .decision-summary.passed .decision-label  { color: #1a7f37 !important; }
            .decision-summary.failed  { border-color: #b42318 !important; } .decision-summary.failed .decision-label  { color: #b42318 !important; }
            .decision-summary.pending { border-color: #9a6700 !important; } .decision-summary.pending .decision-label { color: #9a6700 !important; }
            .decision-summary .decision-reason { color: #111 !important; }
            .decision-summary .decision-reason span, .decision-summary .decision-meta { color: #555 !important; }

            .app-meta .stat { background: #fff !important; border: 1px solid #bbb !important; border-radius: 4px; }
            .app-meta .label { color: #555 !important; }
            .app-meta .value { color: #111 !important; }

            .card { background: #fff !important; border: 1px solid #bbb !important; border-radius: 4px; }
            .qa-block { border-bottom: 1px solid #ddd !important; }
            .qa-block:last-child { border-bottom: none !important; }
            .qa-question { color: #111 !important; }
            .qa-answer { color: #222 !important; }
            .pill, .qa-answer.mc, .qa-answer.mc.incorrect { background: #fff !important; color: #111 !important; border: 1px solid #888; }
            .qa-grade-tag.correct { color: #1a7f37 !important; }
            .qa-grade-tag.incorrect { color: #b42318 !important; }
            .mark-current { color: #555 !important; }
            .mark-current.plus { color: #1a7f37 !important; }
            .mark-current.minus { color: #b42318 !important; }

            .qa-block, .decision-summary, .stat { break-inside: avoid; page-break-inside: avoid; }
        }
    </style>
</head>
<body>
<div class="page">
    <div class="print-only print-header">
        <strong>OsQarek's Universe</strong> — Moderator Application · Printed <span id="printed-at"></span>
    </div>

    <%
        const essays = [
            ['why', '5. Why do you want to be a moderator?'],
            ['experience', '6. Do you have moderating experience, if so where?'],
            ['modAbuse', '7. What do you do if you see another moderator abusing their power?'],
            ['trolling', '8. What if someone is trolling, what do you do?']
        ];
        const choices = [
            ['ruleAbuse', '9. What if someone is abusing the rules, what will you do?'],
            ['pornDms', '10. What if someone sends porn to you in DMs, what do you do?'],
            ['disabilityBullying', '11. What if someone bullies someone for their disability?']
        ];
    %>
    <a href="/mod-applications" class="back">&#8592; Back to All Applications</a>

    <div class="header-row">
        <h1>🛡️ <%= application.username %> <span class="status-badge <%= application.status || 'pending' %>"><%= application.status || 'pending' %></span></h1>
        <div class="header-actions no-print">
            <button type="button" class="btn-print" onclick="window.print()">🖨 Print</button>
            <form method="POST" action="/mod-applications/<%= application.id %>/delete" onsubmit="return confirm('Delete this application? This cannot be undone.')">
            <button type="submit" class="btn-danger-outline">🗑 Delete Application</button>
        </form>
        </div>
    </div>

    <%
        const decisionStatus = application.status || 'pending';
        const decisionName = decisionStatus === 'passed' ? 'PASSED' : decisionStatus === 'failed' ? 'FAILED' : 'PENDING';
    %>
    <div class="decision-summary <%= decisionStatus %>">
        <div class="decision-label"><%= decisionName %></div>
        <% if (application.statusReason) { %>
            <div class="decision-reason"><span>Reason</span><%= application.statusReason %></div>
            <div class="decision-meta">
                Decided<% if (application.decidedBy) { %> by <%= application.decidedBy %><% } %><% if (application.decidedAt) { %> on <%= new Date(application.decidedAt).toLocaleString('en-GB') %><% } %>
            </div>
        <% } else if (decisionStatus !== 'pending') { %>
            <div class="decision-meta">No reason was recorded for this decision.</div>
        <% } else { %>
            <div class="decision-meta">No decision has been made yet.</div>
        <% } %>
    </div>

    <form method="POST" action="/mod-applications/<%= application.id %>/status" class="decision-form no-print" id="decision-form">
        <label for="reason">Reason for decision <span>(required — staff only, shown on printouts)</span></label>
        <textarea name="reason" id="reason" required maxlength="500" placeholder="Why is this application being passed or failed?"><%= application.statusReason || '' %></textarea>
        <div class="decision-row">
            <button type="submit" name="status" value="passed" class="btn-pass">✅ Pass</button>
            <button type="submit" name="status" value="failed" class="btn-fail">❌ Fail</button>
        </div>
    </form>
    <script>
        document.getElementById('decision-form').addEventListener('submit', (e) => {
            const choice = (e.submitter && e.submitter.value || '').toUpperCase();
            if (!confirm('Mark this application as ' + choice + ' and DM the applicant?')) e.preventDefault();
        });
        function stampPrintTime() { var el = document.getElementById('printed-at'); if (el) el.textContent = new Date().toLocaleString('en-GB'); }
        window.addEventListener('beforeprint', stampPrintTime);
        stampPrintTime();
    </script>

    <div class="app-meta">
        <div class="stat"><span class="label">Discord ID</span><span class="value"><%= application.discordId %></span></div>
        <div class="stat"><span class="label">Age</span><span class="value"><%= application.age %></span></div>
        <div class="stat"><span class="label">Joined</span><span class="value"><%= application.joined %></span></div>
        <div class="stat"><span class="label">Country / Time-zone</span><span class="value"><%= application.countryTimezone %></span></div>
        <div class="stat"><span class="label">Submitted</span><span class="value"><%= new Date(application.submittedAt).toLocaleString('en-GB') %></span></div>
    </div>

    <div class="card">
        <% essays.forEach(([field, text]) => { %>
        <div class="qa-block">
            <div class="qa-question"><%= text %></div>
            <div class="qa-answer"><%= application[field] %></div>
        </div>
        <% }) %>
        <% choices.forEach(([field, text]) => { %>
        <div class="qa-block">
            <div class="qa-question"><%= text %></div>
            <div class="qa-answer pills"><% (application[field] || []).forEach(v => { %><span class="pill"><%= v %></span><% }) %></div>
        </div>
        <% }) %>
        <div class="qa-block">
            <div class="qa-question">12. Anything else you want to tell us about you?</div>
            <div class="qa-answer"><%= application.other %></div>
        </div>
    </div>
</div>
</body>
</html>
