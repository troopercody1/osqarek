<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - <%= stats?.botName || 'Dashboard' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=Figtree:wght@400..700&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Figtree', 'Segoe UI', system-ui, sans-serif; 
            background: radial-gradient(ellipse at 50% -10%, #231a5c 0%, #0c0a1f 55%); 
            color: #d6d2f5; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; 
            margin: 0;
            padding: 20px; 
        }
        .login-card { 
            background-color: #171337; 
            padding: 40px; 
            border-radius: 16px; 
            border: 1px solid #2a2561; 
            text-align: center; 
            width: 100%; 
            max-width: 380px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        h1 { font-family: 'Bricolage Grotesque', 'Segoe UI', sans-serif; font-weight: 700; letter-spacing: -.02em; color: #f3f1ff; margin: 14px 0 8px; font-size: 1.7rem; }
        .mark { width: 54px; height: 54px; }
        p { color: #8f8abf; margin-bottom: 30px; font-size: 0.95rem; }
        
        .error-msg {
            background-color: rgba(255, 107, 138, 0.1);
            color: #ff6b8a;
            border: 1px solid #ff6b8a;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }

        .btn-discord { 
            background-color: #5865F2; 
            color: white; 
            padding: 12px 24px; 
            border-radius: 9px; 
            text-decoration: none; 
            font-weight: bold; 
            display: inline-block;
            transition: background 0.2s;
            width: 100%; 
            box-sizing: border-box;
            margin-bottom: 15px; /* Added spacing below */
        }
        .btn-discord:hover { background-color: #4752C4; }

        /* New Admin Button Styling */
        .btn-admin {
            background-color: transparent;
            color: #d6d2f5;
            padding: 12px 24px;
            border-radius: 6px;
            border: 1px solid #8f8abf;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
            transition: all 0.2s;
            width: 100%;
            box-sizing: border-box;
        }
        .btn-admin:hover {
            background-color: #1a1640;
            color: #f3f1ff;
            border-color: #a58bff;
        }

        /* Mobile Optimization */
        @media (max-width: 480px) {
            .login-card {
                padding: 25px; 
            }
            h1 { font-size: 1.5rem; }
        }
    </style>
</head>
<body>
    <div class="login-card">
        <svg class="mark" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="7.5" fill="#7c4dff"/><ellipse cx="20" cy="20" rx="17" ry="7" fill="none" stroke="#a58bff" stroke-width="1.6" transform="rotate(-24 20 20)"/><circle cx="33.6" cy="12.6" r="2.6" fill="#ffc857"/></svg>
        <h1><%= stats?.botName || 'Dashboard' %></h1>
        <p>Sign in to manage OsQarek's Universe.</p>

        <% if (error) { %>
            <div class="error-msg">
                <%= error %>
            </div>
        <% } %>

        <a href="/auth/discord" class="btn-discord">Sign in with Discord</a>
        <a href="/auth/admin" class="btn-admin">Sign in as administrator</a>
    </div>
</body>
</html>
