<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - <%= stats?.botName || 'Dashboard' %></title>
    <style>
        body { 
            font-family: 'Segoe UI', sans-serif; 
            background-color: #16161e; 
            color: #a9b1d6; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; 
            margin: 0;
            padding: 20px; 
        }
        .login-card { 
            background-color: #1a1b26; 
            padding: 40px; 
            border-radius: 12px; 
            border: 1px solid #2f3549; 
            text-align: center; 
            width: 100%; 
            max-width: 350px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        h1 { color: #7aa2f7; margin-bottom: 10px; }
        p { color: #565f89; margin-bottom: 30px; font-size: 0.95rem; }
        
        .error-msg {
            background-color: rgba(247, 118, 142, 0.1);
            color: #f7768e;
            border: 1px solid #f7768e;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }

        .btn-discord { 
            background-color: #5865F2; 
            color: white; 
            padding: 12px 24px; 
            border-radius: 6px; 
            text-decoration: none; 
            font-weight: bold; 
            display: inline-block;
            transition: background 0.2s;
            width: 100%; 
            box-sizing: border-box;
            margin-bottom: 15px; /* Added spacing below */
        }
        .btn-discord:hover { background-color: #4752C4; }

        /* New Admin Button Styling */
        .btn-admin {
            background-color: transparent;
            color: #a9b1d6;
            padding: 12px 24px;
            border-radius: 6px;
            border: 1px solid #565f89;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
            transition: all 0.2s;
            width: 100%;
            box-sizing: border-box;
        }
        .btn-admin:hover {
            background-color: #24283b;
            color: #c0caf5;
            border-color: #7aa2f7;
        }

        /* Mobile Optimization */
        @media (max-width: 480px) {
            .login-card {
                padding: 25px; 
            }
            h1 { font-size: 1.5rem; }
        }
    </style>
</head>
<body>
    <div class="login-card">
        <h1>🌌 <%= stats?.botName || 'Dashboard' %></h1>
        <p>Access the dashboard for OsQarek's Universe Utilities.</p>

        <% if (error) { %>
            <div class="error-msg">
                <%= error %>
            </div>
        <% } %>

        <a href="/auth/discord" class="btn-discord">Login with Discord</a>
        <a href="/auth/admin" class="btn-admin">Login as Administrator</a>
    </div>
</body>
</html>
