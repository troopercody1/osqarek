<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submit a request – <%= botName %> Help Center</title>
    <style>
        :root { --bg:#313338; --bg2:#2b2d31; --bg3:#1e1f22; --hero:#5865F2; --text:#f2f3f5; --dim:#b5bac1; --line:#3f4147; --link:#00a8fc; }
        * { box-sizing: border-box; }
        body { margin:0; background:var(--bg); color:var(--text); font:16px/1.6 'gg sans','Segoe UI',system-ui,sans-serif; }
        a { color:var(--link); text-decoration:none; } a:hover { text-decoration:underline; }
        header.bar { background:var(--bg3); border-bottom:1px solid var(--line); }
        .bar-in { max-width:1100px; margin:0 auto; padding:14px 24px; display:flex; align-items:center; gap:18px; }
        .brand { font-weight:700; color:#fff; font-size:17px; text-decoration:none !important; } .brand span { color:var(--dim); font-weight:500; }
        .wrap { max-width:680px; margin:0 auto; padding:34px 24px 70px; }
        .crumb { color:var(--dim); font-size:14px; margin-bottom:18px; }
        h1 { font-size:30px; margin:0 0 6px; } .lead { color:var(--dim); margin:0 0 26px; }
        label { display:block; font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.04em; color:var(--dim); margin:20px 0 8px; }
        label small { text-transform:none; letter-spacing:0; font-weight:400; }
        input, select, textarea { width:100%; background:var(--bg3); color:var(--text); border:1px solid #1a1b1e; border-radius:6px; padding:11px 12px; font:inherit; font-size:15px; outline:none; }
        input:focus, select:focus, textarea:focus { border-color:var(--hero); }
        textarea { min-height:170px; resize:vertical; }
        .btn { background:var(--hero); color:#fff; border:none; border-radius:6px; padding:12px 26px; font:inherit; font-weight:600; cursor:pointer; margin-top:26px; }
        .btn:hover { background:#4752c4; }
        .err { background:rgba(240,71,71,.12); border:1px solid #f04747; color:#ff9a9a; padding:11px 14px; border-radius:8px; margin-bottom:16px; font-size:14px; }
        .ok { background:var(--bg2); border:1px solid var(--line); border-radius:12px; padding:34px; text-align:center; }
        .ok .tick { font-size:42px; } .ok h1 { margin:8px 0; } .ok code { background:var(--bg3); padding:3px 9px; border-radius:6px; color:#fff; }
        .signed { background:var(--bg3); border:1px solid #1a1b1e; border-radius:6px; padding:11px 12px; font-size:15px; }
        .hp { position:absolute; left:-9999px; height:0; overflow:hidden; }
        .fine { color:var(--dim); font-size:13px; margin-top:16px; }
        footer { background:var(--bg3); border-top:1px solid var(--line); padding:26px 24px; color:var(--dim); font-size:13px; text-align:center; }
        footer a { color:var(--dim); }
    </style>
</head>
<body>
<header class="bar"><div class="bar-in"><a class="brand" href="/support"><%= botName %> <span>Help Center</span></a></div></header>
<div class="wrap">
    <div class="crumb"><a href="/support">Help Center</a> › Submit a request</div>
    <% if (sent) { %>
        <div class="ok">
            <div class="tick">✅</div>
            <h1>Request sent</h1>
            <p style="color:var(--dim);"><%= member ? 'Staff will review it and reply on your request page. You’ll also get a Discord DM when they do.' : 'Staff will review it and reply using the contact details you gave.' %> Your reference is <code><%= sent %></code>.</p>
            <% if (emailedTo) { %><p style="color:var(--dim);">We’ve emailed a confirmation with a summary to <strong style="color:#fff;"><%= emailedTo %></strong>. Check your spam folder if it doesn’t show up.</p><% } %>
            <p style="margin-top:20px;"><a class="btn" style="display:inline-block;text-decoration:none;" href="/support">Back to the Help Center</a>
            <% if (member) { %> <a class="btn" style="display:inline-block;text-decoration:none;" href="/support/requests/<%= sent %>">View request</a> <a class="btn" style="display:inline-block;text-decoration:none;background:transparent;border:1px solid #4e5058;" href="/support/my-requests">My Help Requests</a><% } %></p>
        </div>
    <% } else { %>
        <h1>Submit a request</h1>
        <p class="lead">Tell us what’s going on. Check the <a href="/support">Help Center</a> first. You might find the answer faster.</p>
        <% if (error) { %><div class="err"><%= error %></div><% } %>
        <form method="POST" action="/support/request">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="hp" aria-hidden="true"><label>Leave blank<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>

            <label for="type">What do you need help with?</label>
            <select id="type" name="type" required>
                <% types.forEach(t => { %><option value="<%= t %>" <%= form.type === t ? 'selected' : '' %>><%= t %></option><% }) %>
            </select>

            <% if (member) { %>
            <label>Discord account</label>
            <div class="signed">Signed in as <strong><%= member.username %></strong>. This request will appear under <a href="/support/my-requests">My Help Requests</a>.</div>
            <% } else { %>
            <label for="discord">Discord username</label>
            <input id="discord" name="discord" maxlength="64" required value="<%= form.discord %>" placeholder="e.g. osqarek">
            <p class="fine" style="margin-top:8px;"><a href="/support/login?next=/support/request">Log in with Discord</a> to track this request under “My Help Requests”.</p>
            <% } %>

            <label for="email">Email <small>(optional, only if you can’t receive Discord DMs)</small></label>
            <input id="email" name="email" type="email" maxlength="254" value="<%= form.email %>" placeholder="you@example.com">

            <label for="subject">Subject</label>
            <input id="subject" name="subject" maxlength="120" required value="<%= form.subject %>">

            <label for="message">Description</label>
            <textarea id="message" name="message" maxlength="3000" required placeholder="What happened? What did you expect? Include anything that helps, like dates or usernames."><%= form.message %></textarea>

            <button class="btn" type="submit">Submit</button>
            <p class="fine">Please don’t include passwords or tokens. We use what you send only to handle your request. See the <a href="/privacy">Privacy Policy</a>.</p>
        </form>
    <% } %>
</div>
<footer><a href="/support">Help Center</a> · <a href="/terms">Terms of Service</a> · <a href="/privacy">Privacy Policy</a></footer>
</body>
</html>
