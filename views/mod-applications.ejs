<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Moderator Applications</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Figtree', 'Segoe UI', system-ui, sans-serif; background-color: #0f0d27; color: #d6d2f5; padding: 40px 20px; }
        .page { max-width: 900px; margin: 0 auto; }

        a.back { color: #a58bff; text-decoration: none; font-size: 13px; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px; }
        a.back:hover { color: #a9c5ff; }

        h1 { color: #a58bff; font-size: 22px; font-weight: 600; margin-bottom: 4px; }
        .page-sub { font-size: 13px; color: #8f8abf; margin-bottom: 28px; }

        .card { background: #171337; border: 1px solid #2a2561; border-radius: 12px; overflow: hidden; padding: 20px; }
        .empty-state { color: #8f8abf; padding: 10px 0; font-size: 14px; }

        table { width: 100%; border-collapse: collapse; margin-top: 5px; }
        th { text-align: left; color: #8f8abf; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; padding: 10px 8px; border-bottom: 1px solid #2a2561; }
        td { padding: 12px 8px; border-bottom: 1px solid #2a2561; color: #d6d2f5; font-size: 13.5px; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #1e1a45; }

        .app-answer-badges { display: flex; gap: 6px; flex-wrap: wrap; }
        .answer-badge {
            display: inline-flex; align-items: center; justify-content: center;
            width: 22px; height: 22px; border-radius: 6px;
            background: #221d52; color: #8ecbff; font-size: 0.75rem; font-weight: 700;
        }
        .view-btn {
            display: inline-block; padding: 6px 14px; border-radius: 6px;
            background: #5865f2; color: #fff; text-decoration: none;
            font-size: 12.5px; font-weight: 600;
        }
        .view-btn:hover { background: #4752c4; }
        .row-actions { display: flex; gap: 6px; }
        .delete-btn {
            padding: 6px 12px; border-radius: 6px;
            background: transparent; color: #ff6b8a; border: 1px solid #6a2440;
            font-size: 12.5px; font-weight: 600; cursor: pointer; font-family: inherit;
        }
        .delete-btn:hover { background: rgba(255,107,138,0.1); }

        .status-badge {
            display: inline-block; padding: 3px 10px; border-radius: 99px;
            font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;
        }
        .status-badge.pending { background: #33290f; color: #ffc857; }
        .status-badge.passed { background: #0f2c22; color: #5fe3a1; }
        .status-badge.failed { background: #34152a; color: #ff6b8a; }
    </style>
</head>
<body>
<div class="page">

    <a href="/settings" class="back">&#8592; Back to Settings</a>
    <h1>🛡️ Moderator Applications</h1>
    <p class="page-sub"><%= applications.length %> application<%= applications.length === 1 ? '' : 's' %> submitted via /mod-apps/apply</p>

    <div class="card">
        <% if (applications.length === 0) { %>
            <p class="empty-state">No applications have been submitted yet. Share the application link to start collecting candidates.</p>
        <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>Discord Username</th>
                    <th>Age</th>
                    <th>Country / Time-zone</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% applications.slice().reverse().forEach(app => { %>
                <tr>
                    <td style="color:#f3f1ff; font-weight:600;"><%= app.username %></td>
                    <td><%= app.age %></td>
                    <td><%= app.countryTimezone %></td>
                    <td><%= new Date(app.submittedAt).toLocaleString('en-GB') %></td>
                    <td><span class="status-badge <%= app.status || 'pending' %>"><%= app.status || 'pending' %></span></td>
                    <td>
                        <div class="row-actions">
                            <a href="/mod-applications/<%= app.id %>" class="view-btn">View</a>
                            <form method="POST" action="/mod-applications/<%= app.id %>/delete" onsubmit="return confirm('Delete this application? This cannot be undone.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="delete-btn">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
        <% } %>
    </div>

</div>
</body>
</html>
