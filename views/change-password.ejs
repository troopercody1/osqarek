<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set Your Password</title>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #16161e;
            color: #a9b1d6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }
        .login-card {
            background-color: #1a1b26;
            padding: 40px;
            border-radius: 12px;
            border: 1px solid #2f3549;
            text-align: center;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        h2 { color: #7aa2f7; margin-bottom: 6px; margin-top: 0; }
        p.sub { color: #565f89; font-size: 13px; margin: 0 0 20px; line-height: 1.5; }
        p.sub strong { color: #a9b1d6; }

        .error-msg { background-color: rgba(247, 118, 142, 0.1); color: #f7768e; border: 1px solid #f7768e; padding: 10px; border-radius: 6px; margin-bottom: 20px; font-size: 0.9rem; }

        .btn-success {
            background-color: #9ece6a;
            color: #1a1b26;
            padding: 12px;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            font-size: 1rem;
            transition: opacity 0.2s;
        }
        .btn-success:hover { opacity: 0.9; }

        label { display: block; text-align: left; font-size: 12px; color: #565f89; margin-bottom: 6px; }

        input[type="password"] {
            width: 100%;
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #565f89;
            background: #16161e;
            color: white;
            margin-bottom: 16px;
            box-sizing: border-box;
            font-size: 1.1rem;
            text-align: center;
            letter-spacing: 4px;
        }
        input[type="password"]:focus { outline: none; border-color: #7aa2f7; }

        .hint { font-size: 11.5px; color: #565f89; margin-top: -8px; margin-bottom: 18px; text-align: left; }
    </style>
</head>
<body>

    <div class="login-card">
        <h2>🔒 Set Your Password</h2>
        <p class="sub">Welcome, <strong><%= username %></strong>. This is your first login — choose your own 6-digit password before continuing.</p>

        <% if (error) { %> <div class="error-msg"><%= error %></div> <% } %>

        <form action="/auth/change-password" method="POST" id="changePasswordForm">
            <label for="newPassword">New password</label>
            <input type="password" id="newPassword" name="newPassword" placeholder="123456" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">
            <div class="hint">Exactly 6 numbers. Can't be the same as your current password.</div>

            <label for="confirmPassword">Confirm new password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="123456" inputmode="numeric" pattern="\d{6}" maxlength="6" minlength="6" required autocomplete="off">

            <button type="submit" class="btn-success">Save Password & Continue</button>
        </form>
    </div>

    <script>
        // Light client-side guardrails; the server re-validates everything
        // regardless (numbers-only, length, and "not the same as before").
        document.getElementById('changePasswordForm').addEventListener('submit', (e) => {
            const a = document.getElementById('newPassword').value;
            const b = document.getElementById('confirmPassword').value;
            if (!/^\d{6}$/.test(a)) {
                e.preventDefault();
                alert('Password must be exactly 6 numbers.');
                return;
            }
            if (a !== b) {
                e.preventDefault();
                alert('Passwords do not match.');
            }
        });
    </script>

</body>
</html>
