<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Mailbox</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', sans-serif; background-color: #16161e; color: #a9b1d6; padding: 40px 20px; }
        .page { max-width: 760px; margin: 0 auto; }
        a { color: #7aa2f7; text-decoration: none; }
        a:hover { color: #a9c5ff; }
        a.back { font-size: 13px; display: inline-flex; gap: 6px; margin-bottom: 24px; }
        h1 { color: #7aa2f7; font-size: 22px; font-weight: 600; margin-bottom: 4px; }
        .page-sub { font-size: 13px; color: #565f89; margin-bottom: 20px; }
        .flash { padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 18px; border: 1px solid; }
        .flash.ok  { background: rgba(158,206,106,.1); color: #9ece6a; border-color: #9ece6a; }
        .flash.bad { background: rgba(247,118,142,.1); color: #f7768e; border-color: #f7768e; }
        .card { background: #1a1b26; border: 1px solid #2f3549; border-radius: 12px; overflow: hidden; margin-bottom: 18px; }
        .toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
        .toolbar form { display: flex; gap: 8px; flex: 1; min-width: 220px; }
        input[type=text], input[type=email], textarea { background: #1a1b26; border: 1px solid #2f3549; color: #c0caf5; padding: 8px 10px; border-radius: 6px; width: 100%; font-family: 'Segoe UI', sans-serif; font-size: 13px; }
        textarea { min-height: 180px; resize: vertical; line-height: 1.5; }
        input:focus, textarea:focus { outline: none; border-color: #7aa2f7; }
        label { font-size: 12px; color: #565f89; display: block; margin: 14px 0 6px; }
        .btn { font-size: 13px; font-weight: 500; padding: 7px 14px; border-radius: 6px; border: 1px solid #2f3549; background: #1a1b26; color: #c0caf5; cursor: pointer; font-family: 'Segoe UI', sans-serif; white-space: nowrap; display: inline-block; }
        .btn:hover { background: #252636; color: #c0caf5; }
        .btn-primary { background: #5865f2; color: #fff; border-color: transparent; }
        .btn-primary:hover { background: #4752c4; color: #fff; }
        .btn.active { border-color: #7aa2f7; color: #7aa2f7; }
        .msg-row { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #2f3549; }
        .msg-row:last-child { border-bottom: none; }
        .msg-row:hover { background: #1f2030; }
        .dot { width: 8px; height: 8px; border-radius: 50%; background: transparent; flex-shrink: 0; }
        .unread .dot { background: #7aa2f7; }
        .msg-main { flex: 1; min-width: 0; display: block; color: inherit; }
        .msg-from { font-size: 13px; color: #c0caf5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .msg-subject { font-size: 12px; color: #565f89; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
        .unread .msg-from, .unread .msg-subject { font-weight: 600; }
        .unread .msg-subject { color: #a9b1d6; }
        .msg-date { font-size: 11px; color: #565f89; flex-shrink: 0; }
        .tag { font-size: 10px; padding: 2px 7px; border-radius: 99px; background: #1a1f3a; color: #7aa2f7; margin-left: 6px; }
        .empty { padding: 28px; text-align: center; font-size: 13px; color: #565f89; }
        .pager { display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: #565f89; margin-bottom: 18px; }
        .pad { padding: 18px; }
        .meta { font-size: 12px; color: #565f89; line-height: 1.7; }
        .meta b { color: #a9b1d6; font-weight: 500; }
        .subject { font-size: 17px; color: #c0caf5; font-weight: 600; margin-bottom: 10px; }
        .body-text { white-space: pre-wrap; word-wrap: break-word; font-size: 13.5px; line-height: 1.6; color: #c0caf5; padding: 18px; border-top: 1px solid #2f3549; }
        iframe.mail-html { width: 100%; height: 480px; border: none; border-top: 1px solid #2f3549; background: #fff; }
        .atts { padding: 12px 18px; border-top: 1px solid #2f3549; font-size: 12px; color: #565f89; }
        .setup code { background: #13131a; padding: 2px 6px; border-radius: 4px; color: #e0af68; font-size: 12px; }
        .setup li { margin: 6px 0 6px 18px; font-size: 13px; line-height: 1.6; }
    </style>
</head>
<body>
<div class="page">

    <a href="<%= view === 'list' ? '/settings' : '/settings/mail' %>" class="back">&#8592; <%= view === 'list' ? 'Back to Settings' : 'Back to Inbox' %></a>
    <h1>Mailbox</h1>
    <p class="page-sub"><%= configured ? 'Signed in as ' + mailUser : 'Not connected' %></p>

    <% if (msg) { %><div class="flash ok">&#9989; <%= msg %></div><% } %>
    <% if (err) { %><div class="flash bad">&#9888; <%= err %></div><% } %>

    <% if (!configured) { %>
        <div class="card pad setup">
            <div class="subject" style="font-size:15px;">Connect a mailbox</div>
            <p class="meta">Set these environment variables, then restart the bot. Credentials stay in the environment and are never saved to the database.</p>
            <ul style="margin-top:10px;">
                <li><code>MAIL_USER</code> and <code>MAIL_PASS</code> — mailbox login (use an app password for Gmail/Outlook)</li>
                <li><code>MAIL_IMAP_HOST</code> — e.g. <code>imap.gmail.com</code> (port <code>MAIL_IMAP_PORT</code>, default 993)</li>
                <li><code>MAIL_SMTP_HOST</code> — e.g. <code>smtp.gmail.com</code> (port <code>MAIL_SMTP_PORT</code>, default 465)</li>
                <li>Optional: <code>MAIL_FROM</code>, <code>MAIL_FROM_NAME</code>, <code>MAIL_ALERT_TO</code></li>
            </ul>
        </div>

    <% } else if (view === 'compose') { %>
        <form class="card pad" method="POST" action="/settings/mail/send">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label style="margin-top:0;">To</label>
            <input type="email" name="to" required maxlength="254" value="<%= compose.to %>" placeholder="name@example.com">
            <label>Subject</label>
            <input type="text" name="subject" required maxlength="200" value="<%= compose.subject %>">
            <label>Message</label>
            <textarea name="body" required maxlength="20000"><%= compose.body %></textarea>
            <div style="margin-top:14px; display:flex; gap:8px;">
                <button class="btn btn-primary" type="submit">Send</button>
                <a class="btn" href="/settings/mail">Cancel</a>
            </div>
        </form>

    <% } else if (view === 'read' && thread) {
        const cspMeta = '<meta http-equiv="Content-Security-Policy" content="default-src \'none\'; img-src data:; style-src \'unsafe-inline\'"><base target="_blank">'; %>
        <div class="card">
            <div class="pad">
                <div class="subject"><%= thread.subject %></div>
                <div class="meta">
                    <b>From:</b> <%= thread.from.map(a => a.name ? a.name + ' <' + a.address + '>' : a.address).join(', ') %><br>
                    <b>To:</b> <%= thread.to.map(a => a.address).join(', ') %><br>
                    <% if (thread.cc.length) { %><b>Cc:</b> <%= thread.cc.map(a => a.address).join(', ') %><br><% } %>
                    <% if (thread.date) { %><b>Date:</b> <%= new Date(thread.date).toLocaleString('en-GB', { timeZone: 'UTC' }) %> UTC<% } %>
                </div>
                <div style="margin-top:12px; display:flex; gap:8px; flex-wrap:wrap;">
                    <form method="POST" action="/settings/mail/<%= thread.uid %>/toggle-read" style="display:contents;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="seen" value="0">
                        <button class="btn" type="submit">Mark unread</button>
                    </form>
                </div>
            </div>

            <% if (thread.html) { %>
                <!-- Sender HTML is untrusted: scripts disabled via sandbox, remote content blocked via CSP. -->
                <iframe class="mail-html" sandbox="" referrerpolicy="no-referrer"
                        srcdoc="<%= cspMeta + thread.html %>"></iframe>
                <div class="atts">Remote images are blocked for privacy. <a href="#plain" onclick="document.getElementById('plain').style.display='block'; return false;">Show plain-text version</a></div>
                <div class="body-text" id="plain" style="display:none;"><%= thread.text %></div>
            <% } else { %>
                <div class="body-text"><%= thread.text || '(empty message)' %></div>
            <% } %>

            <% if (thread.attachments.length) { %>
                <div class="atts">&#128206; <%= thread.attachments.length %> attachment(s) not shown here:
                    <%= thread.attachments.map(a => a.name + ' (' + Math.max(1, Math.round(a.size / 1024)) + ' KB)').join(', ') %></div>
            <% } %>
        </div>

        <form class="card pad" method="POST" action="/settings/mail/<%= thread.uid %>/reply">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="meta" style="margin-bottom:8px;">Reply to <b><%= (thread.replyTo[0] || thread.from[0] || {}).address %></b> &middot; the original is quoted below your message</div>
            <textarea name="body" required maxlength="20000" placeholder="Write your reply…"></textarea>
            <div style="margin-top:14px;"><button class="btn btn-primary" type="submit">Send reply</button></div>
        </form>

    <% } else if (list) { %>
        <div class="toolbar">
            <form method="GET" action="/settings/mail">
                <input type="text" name="q" value="<%= filters.q %>" placeholder="Search subject or sender" maxlength="100">
                <% if (filters.unread) { %><input type="hidden" name="unread" value="1"><% } %>
                <button class="btn" type="submit">Search</button>
            </form>
            <a class="btn <%= filters.unread ? 'active' : '' %>" href="/settings/mail<%= filters.unread ? '' : '?unread=1' %>">Unread only</a>
            <a class="btn btn-primary" href="/settings/mail/compose">Compose</a>
        </div>

        <div class="card">
            <% if (!list.messages.length) { %>
                <div class="empty"><%= filters.q || filters.unread ? 'No messages match.' : 'Your inbox is empty.' %></div>
            <% } %>
            <% list.messages.forEach(m => { %>
                <div class="msg-row <%= m.seen ? '' : 'unread' %>">
                    <span class="dot"></span>
                    <a class="msg-main" href="/settings/mail/<%= m.uid %>">
                        <div class="msg-from"><%= m.from %><% if (m.answered) { %><span class="tag">replied</span><% } %></div>
                        <div class="msg-subject"><%= m.subject %></div>
                    </a>
                    <div class="msg-date"><%= m.date ? new Date(m.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }) : '' %></div>
                    <form method="POST" action="/settings/mail/<%= m.uid %>/toggle-read" style="display:contents;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="seen" value="<%= m.seen ? '0' : '1' %>">
                        <button class="btn" type="submit" title="Toggle read"><%= m.seen ? 'Unread' : 'Read' %></button>
                    </form>
                </div>
            <% }) %>
        </div>

        <% if (list.pages > 1) {
            const qs = (p) => '?page=' + p + (filters.q ? '&q=' + encodeURIComponent(filters.q) : '') + (filters.unread ? '&unread=1' : ''); %>
        <div class="pager">
            <span><%= list.total %> message<%= list.total === 1 ? '' : 's' %> &middot; page <%= list.page %> of <%= list.pages %></span>
            <span>
                <% if (list.page > 1) { %><a class="btn" href="/settings/mail<%= qs(list.page - 1) %>">&#8592; Newer</a><% } %>
                <% if (list.page < list.pages) { %><a class="btn" href="/settings/mail<%= qs(list.page + 1) %>">Older &#8594;</a><% } %>
            </span>
        </div>
        <% } %>
    <% } %>

</div>
</body>
</html>
