<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Help Requests – <%= botName %> Help Center</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:wght@400..700&display=swap" rel="stylesheet">
    <style>
        :root { --bg:#0c0a1f; --bg2:#171337; --bg3:#0f0d27; --hero:#7c4dff; --text:#f3f1ff; --dim:#8f8abf; --line:#2a2561; --link:#8ecbff; }
        * { box-sizing: border-box; }
        body { margin:0; background:var(--bg); color:var(--text); font:16px/1.6 'Figtree','Segoe UI',system-ui,sans-serif; }
        a { color:var(--link); text-decoration:none; } a:hover { text-decoration:underline; }
        header.bar { background:var(--bg3); border-bottom:1px solid var(--line); }
        .bar-in { max-width:1100px; margin:0 auto; padding:14px 24px; display:flex; align-items:center; gap:18px; }
        .brand { font-weight:700; color:#fff; font-size:17px; text-decoration:none !important; } .brand span { color:var(--dim); font-weight:500; }
        .sp { flex:1; }
        .btn { display:inline-block; background:var(--hero); color:#fff !important; font-weight:600; font-size:14px; padding:9px 18px; border-radius:6px; border:none; cursor:pointer; font-family:inherit; text-decoration:none !important; }
        .btn:hover { background:#6a3df0; }
        .linkbtn { background:none; border:none; color:var(--dim); cursor:pointer; font:inherit; font-size:14px; padding:0; } .linkbtn:hover { color:#fff; }
        .wrap { max-width:820px; margin:0 auto; padding:34px 24px 70px; }
        .crumb { color:var(--dim); font-size:14px; margin-bottom:18px; }
        h1 { font-size:30px; margin:0 0 6px; } .lead { color:var(--dim); margin:0 0 26px; }
        a.req { display:flex; align-items:center; gap:16px; background:var(--bg2); border:1px solid var(--line); border-radius:10px; padding:16px 20px; margin-bottom:12px; color:inherit; text-decoration:none !important; }
        a.req:hover { border-color:#3a3478; background:#1f1a49; }
        .main { flex:1; min-width:0; } .subj { font-weight:600; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .meta { font-size:12.5px; color:var(--dim); margin-top:3px; }
        .meta b { color:#d6d2f5; font-weight:500; }
        .right { text-align:right; flex-shrink:0; }
        .badge { display:inline-block; font-size:12px; font-weight:700; padding:3px 10px; border-radius:99px; }
        .st-open { background:#1a2e3a; color:#8ecbff; } .st-awaiting { background:#33290f; color:#ffc857; } .st-solved { background:#2a2561; color:#d6d2f5; }
        .act { font-size:12px; color:var(--dim); margin-top:5px; }
        .tabs { display:flex; gap:8px; flex-wrap:wrap; margin:0 0 18px; }
        .tab { background:var(--bg2); border:1px solid var(--line); color:var(--dim); border-radius:99px; padding:5px 14px; font:inherit; font-size:13px; cursor:pointer; }
        .tab:hover { color:#fff; } .tab.on { background:var(--hero); border-color:var(--hero); color:#fff; }
        @media (max-width:640px) { a.req { flex-direction:column; align-items:flex-start; gap:10px; } .right { text-align:left; } }
        .empty { background:var(--bg2); border:1px dashed var(--line); border-radius:12px; padding:36px; text-align:center; color:var(--dim); }
        .empty .btn { margin-top:14px; }
        .fine { color:var(--dim); font-size:13px; margin-top:22px; }
        footer { background:var(--bg3); border-top:1px solid var(--line); padding:26px 24px; color:var(--dim); font-size:13px; text-align:center; } footer a { color:var(--dim); }
        h1, h2, h3 { font-family: 'Bricolage Grotesque', 'Segoe UI', system-ui, sans-serif; letter-spacing: -.01em; }
    :focus-visible { outline: 2px solid #ffc857; outline-offset: 2px; }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; scroll-behavior: auto !important; } }
.homebtn { display:inline-flex; align-items:center; gap:7px; color:var(--dim); font-size:14px; font-weight:600; text-decoration:none !important; padding:6px 14px; border:1px solid var(--line); border-radius:999px; } .homebtn:hover { color:#fff; border-color:var(--hero); }
</style>
</head>
<body>
<header class="bar"><div class="bar-in">
    <a class="brand" href="/support"><%= botName %> <span>Help Center</span></a>
    <span class="sp"></span>
    <a class="homebtn" href="/login"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10"/></svg>Home</a>
    <form method="POST" action="/support/logout" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="linkbtn" type="submit">Log out (<%= member.username %>)</button></form>
    <a class="btn" href="/support/request">Submit a request</a>
</div></header>
<div class="wrap">
    <div class="crumb"><a href="/support">Help Center</a> › My Help Requests</div>
    <h1>My Help Requests</h1>
    <p class="lead">Signed in as <strong><%= member.username %></strong>. Open a request to read the replies and answer from here.</p>

    <% if (!requests.length) { %>
        <div class="empty">
            <div style="font-size:34px;">📭</div>
            <p style="margin:8px 0 0;">You haven’t submitted any requests while logged in.</p>
            <a class="btn" href="/support/request">Submit a request</a>
        </div>
    <% } %>

    <% if (requests.length) { %>
    <div class="tabs" id="tabs">
        <button class="tab on" data-f="all" type="button">All (<%= requests.length %>)</button>
        <% ['open','awaiting','solved'].forEach(k => { const n = requests.filter(x => x.status === k).length; %>
            <button class="tab" data-f="<%= k %>" type="button"><%= STATUS[k].member %> (<%= n %>)</button>
        <% }) %>
    </div>
    <% } %>

    <% requests.forEach(r => { %>
    <a class="req" href="/support/requests/<%= r.id %>" data-status="<%= r.status %>">
        <div class="main">
            <div class="subj"><%= r.subject %></div>
            <div class="meta"><%= r.id %> · <%= r.type %> · Created <b><%= full(r.createdAt) %></b></div>
        </div>
        <div class="right">
            <span class="badge st-<%= r.status %>"><%= STATUS[r.status].member %></span>
            <div class="act">Last activity <%= ago(r.updatedAt) %></div>
        </div>
    </a>
    <% }) %>

    <% if (requests.length) { %><p class="fine"><%= requests.length %> request<%= requests.length === 1 ? '' : 's' %>. Requests sent before you logged in, or while logged out, can’t be linked to your account and won’t appear here.</p><% } %>
</div>
<script>
    var tabs = document.querySelectorAll('.tab'), rows = document.querySelectorAll('a.req');
    tabs.forEach(function (t) { t.addEventListener('click', function () {
        tabs.forEach(function (x) { x.classList.toggle('on', x === t); });
        rows.forEach(function (r) { r.style.display = (t.dataset.f === 'all' || r.dataset.status === t.dataset.f) ? '' : 'none'; });
    }); });
</script>
<footer><a href="/support">Help Center</a> · <a href="/terms">Terms of Service</a> · <a href="/privacy">Privacy Policy</a></footer>
</body>
</html>
