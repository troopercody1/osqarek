<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Co-Owner Application — <%= application.username %></title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', sans-serif; background-color: #16161e; color: #a9b1d6; padding: 40px 20px; }
        .page { max-width: 720px; margin: 0 auto; }

        a.back { color: #7aa2f7; text-decoration: none; font-size: 13px; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px; }
        a.back:hover { color: #a9c5ff; }

        h1 { color: #7aa2f7; font-size: 22px; font-weight: 600; margin-bottom: 20px; }

        .app-meta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }
        .app-meta .stat { background: #1a1b26; border: 1px solid #2f3549; border-radius: 10px; padding: 12px 16px; flex: 1; min-width: 140px; }
        .app-meta .label { display: block; color: #565f89; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
        .app-meta .value { color: #c0caf5; font-weight: 600; font-size: 15px; }

        .card { background: #1a1b26; border: 1px solid #2f3549; border-radius: 12px; padding: 4px 20px; }

        .qa-block { padding: 18px 0; border-bottom: 1px solid #2f3549; }
        .qa-block:last-child { border-bottom: none; }
        .qa-question { color: #7dcfff; font-size: 13px; font-weight: 600; margin-bottom: 8px; }
        .qa-answer { color: #a9b1d6; line-height: 1.6; white-space: pre-wrap; font-size: 14px; }
        .qa-answer.mc {
            display: inline-block; padding: 4px 12px; border-radius: 6px;
            background: #1a2e1a; color: #9ece6a; font-weight: 700; font-size: 13px;
        }
        .qa-answer.mc.incorrect { background: #2e1a1a; color: #f7768e; }
        .qa-grade-tag {
            display: inline-block; margin-left: 8px; font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.03em;
        }
        .qa-grade-tag.correct { color: #9ece6a; }
        .qa-grade-tag.incorrect { color: #f7768e; }

        .mark-row { display: flex; align-items: center; gap: 8px; margin-top: 12px; }
        .mark-btn {
            width: 30px; height: 30px; border-radius: 8px; border: 1px solid #2f3549;
            background: #1c1f28; color: #a9b1d6; font-size: 14px; font-weight: 700;
            cursor: pointer; font-family: inherit; display: inline-flex; align-items: center; justify-content: center;
            transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
        }
        .mark-btn:hover { border-color: #3a3f4d; }
        .mark-btn.plus.active { background: #1a2e1a; color: #9ece6a; border-color: #2c4a2c; }
        .mark-btn.minus.active { background: #2e1a1a; color: #f7768e; border-color: #4a2c2c; }
        .mark-current {
            font-size: 12px; font-weight: 700; color: #565f89; min-width: 60px;
        }
        .mark-current.plus { color: #9ece6a; }
        .mark-current.minus { color: #f7768e; }
        .mark-saved-flash { opacity: 0; transition: opacity 0.2s ease; font-size: 11px; color: #565f89; }
        .mark-saved-flash.show { opacity: 1; }

        .header-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
        .header-row h1 { margin-bottom: 0; }
        .btn-danger-outline {
            background: transparent; color: #f7768e; border: 1px solid #4a1c1c;
            padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
            cursor: pointer; font-family: inherit;
        }
        .btn-danger-outline:hover { background: rgba(247,118,142,0.1); }

        .status-badge {
            display: inline-block; padding: 4px 12px; border-radius: 99px;
            font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;
        }
        .status-badge.pending { background: #2e2a1a; color: #e0af68; }
        .status-badge.passed { background: #1a2e1a; color: #9ece6a; }
        .status-badge.failed { background: #2e1a1a; color: #f7768e; }

        .decision-row { display: flex; gap: 10px; margin-bottom: 24px; }
        .btn-pass, .btn-fail {
            padding: 9px 18px; border-radius: 8px; font-size: 13.5px; font-weight: 700;
            border: none; cursor: pointer; font-family: inherit;
        }
        .btn-pass { background: #1a2e1a; color: #9ece6a; }
        .btn-pass:hover { background: #234023; }
        .btn-fail { background: #2e1a1a; color: #f7768e; }
        .btn-fail:hover { background: #402323; }
    </style>
</head>
<body>
<div class="page">
    <%
        const mcOptions = {
            arguingStaff: { A: 'Encourage them', B: 'Temporarily suspend them', C: 'Ignore them', D: 'Join them' },
            escalation: { A: 'Whenever a user disagrees with a warning', B: 'Only when a server boost is threatened', C: 'When dealing with threats of self-harm, doxxing, or severe safety breaches', D: 'Never, staff should handle everything alone' },
            fairDiscipline: { A: 'Punish the new member harshly and ignore the trusted member completely', B: 'Apply the server rules fairly and consistently regardless of how long someone has been in the community', C: 'Ban both users permanently without a warning', D: 'Ask the general chat to vote on whether rules should apply to old members' },
            security: { A: 'Turning off all text channels for everyone', B: 'Requiring Two-Factor Authentication (2FA) for all staff roles and properly configuring channel permissions', C: 'Asking members to politely tell the hacker to stop', D: 'Deleting the entire server immediately' }
        };
        const mcLabel = (field) => {
            const letter = application[field];
            const text = (mcOptions[field] || {})[letter];
            return text ? `${letter} - ${text}` : letter;
        };
        // Maps the application's short field name to the answer-key's form
        // field name so we can look up auto-grade correctness for it.
        const mcKeyFieldMap = { arguingStaff: 'q11_arguing_staff', escalation: 'q12_escalation', fairDiscipline: 'q13_fair_discipline', security: 'q14_security' };
        const isMcCorrect = (field) => !!(score.mcCorrect || {})[mcKeyFieldMap[field]];
    %>

    <a href="/co-owner-applications" class="back">&#8592; Back to All Applications</a>

    <div class="header-row">
        <h1>👑 <%= application.username %> <span class="status-badge <%= application.status || 'pending' %>"><%= application.status || 'pending' %></span></h1>
        <form method="POST" action="/co-owner-applications/<%= application.id %>/delete" onsubmit="return confirm('Delete this application? This cannot be undone.')">
            <button type="submit" class="btn-danger-outline">🗑 Delete Application</button>
        </form>
    </div>

    <div class="decision-row">
        <form method="POST" action="/co-owner-applications/<%= application.id %>/status" onsubmit="return confirm('Mark this application as PASSED and DM the applicant?')">
            <input type="hidden" name="status" value="passed">
            <button type="submit" class="btn-pass">✅ Pass</button>
        </form>
        <form method="POST" action="/co-owner-applications/<%= application.id %>/status" onsubmit="return confirm('Mark this application as FAILED and DM the applicant?')">
            <input type="hidden" name="status" value="failed">
            <button type="submit" class="btn-fail">❌ Fail</button>
        </form>
    </div>


    <div class="app-meta">
        <div class="stat"><span class="label">Time-zone</span><span class="value"><%= application.timezone %></span></div>
        <div class="stat"><span class="label">Age</span><span class="value"><%= application.age %></span></div>
        <div class="stat"><span class="label">Submitted</span><span class="value"><%= new Date(application.submittedAt).toLocaleString('en-GB') %></span></div>
        <div class="stat"><span class="label">Multiple Choice</span><span class="value"><%= score.mcScore %> / <%= score.mcMax %> auto-graded</span></div>
        <div class="stat"><span class="label">Total Score</span><span class="value" id="total-score-value"><%= score.totalScore %> pts</span></div>
    </div>

    <div class="card">
        <%
            const essayQuestions = [
                { field: 'motivation', num: 4, text: 'What makes you want this position in this server, other than another staff role?' },
                { field: 'vision', num: 5, text: 'Where do you see yourself in 6 months, and what improvements would you make to the server?' },
                { field: 'stress', num: 6, text: 'How do you handle stress?' },
                { field: 'experience', num: 7, text: 'What is your past moderator experience in this server?' },
                { field: 'unpopularDecisions', num: 8, text: 'As a co-owner, or part of any ownership team, how would you handle communicating unpopular decisions to members who disagree?' },
                { field: 'feedback', num: 9, text: 'How do you prefer to receive feedback from the server owner and other staff members when you make a mistake?' },
                { field: 'authorityBalance', num: 10, text: 'How will you handle being a person of authority, and being a friendly member towards others?' }
            ];
        %>
        <% essayQuestions.forEach(q => { const mark = (application.marks || {})[q.field]; %>
        <div class="qa-block" data-field="<%= q.field %>">
            <div class="qa-question"><%= q.num %>. <%= q.text %></div>
            <div class="qa-answer"><%= application[q.field] %></div>
            <div class="mark-row">
                <button type="button" class="mark-btn plus <%= mark === 1 ? 'active' : '' %>" data-action="plus" title="Add 1 point">+1</button>
                <button type="button" class="mark-btn minus <%= mark === -1 ? 'active' : '' %>" data-action="minus" title="Subtract 1 point">-1</button>
                <button type="button" class="mark-btn clear" data-action="clear" title="Remove mark">✕</button>
                <span class="mark-current <%= mark === 1 ? 'plus' : mark === -1 ? 'minus' : '' %>">
                    <%= mark === 1 ? 'Marked +1' : mark === -1 ? 'Marked -1' : 'Unmarked' %>
                </span>
                <span class="mark-saved-flash">Saved ✓</span>
            </div>
        </div>
        <% }) %>
        <div class="qa-block">
            <div class="qa-question">11. Two staff members are arguing in general and violating the rules. What would you do?</div>
            <div class="qa-answer mc <%= isMcCorrect('arguingStaff') ? '' : 'incorrect' %>"><%= mcLabel('arguingStaff') %></div>
            <span class="qa-grade-tag <%= isMcCorrect('arguingStaff') ? 'correct' : 'incorrect' %>"><%= isMcCorrect('arguingStaff') ? '✓ Correct' : '✗ Incorrect' %></span>
        </div>
        <div class="qa-block">
            <div class="qa-question">12. When should a staff member escalate a situation directly to the owner team?</div>
            <div class="qa-answer mc <%= isMcCorrect('escalation') ? '' : 'incorrect' %>"><%= mcLabel('escalation') %></div>
            <span class="qa-grade-tag <%= isMcCorrect('escalation') ? 'correct' : 'incorrect' %>"><%= isMcCorrect('escalation') ? '✓ Correct' : '✗ Incorrect' %></span>
        </div>
        <div class="qa-block">
            <div class="qa-question">13. A trusted member breaks a minor rule for the first time; a new member breaks a major rule. How should discipline be approached?</div>
            <div class="qa-answer mc <%= isMcCorrect('fairDiscipline') ? '' : 'incorrect' %>"><%= mcLabel('fairDiscipline') %></div>
            <span class="qa-grade-tag <%= isMcCorrect('fairDiscipline') ? 'correct' : 'incorrect' %>"><%= isMcCorrect('fairDiscipline') ? '✓ Correct' : '✗ Incorrect' %></span>
        </div>
        <div class="qa-block">
            <div class="qa-question">14. Best preventative security measure against a hacked moderator account?</div>
            <div class="qa-answer mc <%= isMcCorrect('security') ? '' : 'incorrect' %>"><%= mcLabel('security') %></div>
            <span class="qa-grade-tag <%= isMcCorrect('security') ? 'correct' : 'incorrect' %>"><%= isMcCorrect('security') ? '✓ Correct' : '✗ Incorrect' %></span>
        </div>
    </div>

    <script>
        // Wires up the +1 / -1 / ✕ buttons on each free-response answer.
        // Clicking one immediately POSTs to the server and saves — no page
        // reload, no separate "save" button.
        document.querySelectorAll('.qa-block[data-field]').forEach((block) => {
            const field = block.dataset.field;
            const plusBtn = block.querySelector('.mark-btn.plus');
            const minusBtn = block.querySelector('.mark-btn.minus');
            const clearBtn = block.querySelector('.mark-btn.clear');
            const currentLabel = block.querySelector('.mark-current');
            const savedFlash = block.querySelector('.mark-saved-flash');

            function applyUiState(action) {
                plusBtn.classList.toggle('active', action === 'plus');
                minusBtn.classList.toggle('active', action === 'minus');
                currentLabel.classList.remove('plus', 'minus');
                if (action === 'plus') {
                    currentLabel.textContent = 'Marked +1';
                    currentLabel.classList.add('plus');
                } else if (action === 'minus') {
                    currentLabel.textContent = 'Marked -1';
                    currentLabel.classList.add('minus');
                } else {
                    currentLabel.textContent = 'Unmarked';
                }
            }

            async function sendMark(action) {
                const previousAction = plusBtn.classList.contains('active') ? 'plus' : minusBtn.classList.contains('active') ? 'minus' : 'clear';
                applyUiState(action); // optimistic update
                try {
                    const res = await fetch('/co-owner-applications/<%= application.id %>/mark', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ field, action })
                    });
                    if (!res.ok) throw new Error('Request failed');
                    const data = await res.json();
                    const totalEl = document.getElementById('total-score-value');
                    if (totalEl && typeof data.totalScore === 'number') totalEl.textContent = data.totalScore + ' pts';
                    savedFlash.classList.add('show');
                    setTimeout(() => savedFlash.classList.remove('show'), 1200);
                } catch (err) {
                    console.error('Failed to save mark:', err);
                    applyUiState(previousAction); // revert on failure
                    alert('Could not save that mark. Please try again.');
                }
            }

            plusBtn.addEventListener('click', () => sendMark(plusBtn.classList.contains('active') ? 'clear' : 'plus'));
            minusBtn.addEventListener('click', () => sendMark(minusBtn.classList.contains('active') ? 'clear' : 'minus'));
            clearBtn.addEventListener('click', () => sendMark('clear'));
        });
    </script>

</div>
</body>
</html>
