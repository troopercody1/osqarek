<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Co-Owner Application — <%= application.username %></title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', sans-serif; background-color: #16161e; color: #a9b1d6; padding: 40px 20px; }
        .page { max-width: 720px; margin: 0 auto; }

        a.back { color: #7aa2f7; text-decoration: none; font-size: 13px; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px; }
        a.back:hover { color: #a9c5ff; }

        h1 { color: #7aa2f7; font-size: 22px; font-weight: 600; margin-bottom: 20px; }

        .app-meta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }
        .app-meta .stat { background: #1a1b26; border: 1px solid #2f3549; border-radius: 10px; padding: 12px 16px; flex: 1; min-width: 140px; }
        .app-meta .label { display: block; color: #565f89; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
        .app-meta .value { color: #c0caf5; font-weight: 600; font-size: 15px; }

        .card { background: #1a1b26; border: 1px solid #2f3549; border-radius: 12px; padding: 4px 20px; }

        .qa-block { padding: 18px 0; border-bottom: 1px solid #2f3549; }
        .qa-block:last-child { border-bottom: none; }
        .qa-question { color: #7dcfff; font-size: 13px; font-weight: 600; margin-bottom: 8px; }
        .qa-answer { color: #a9b1d6; line-height: 1.6; white-space: pre-wrap; font-size: 14px; }
        .qa-answer.mc {
            display: inline-block; padding: 4px 12px; border-radius: 6px;
            background: #1a2e1a; color: #9ece6a; font-weight: 700; font-size: 13px;
        }

        .header-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
        .header-row h1 { margin-bottom: 0; }
        .btn-danger-outline {
            background: transparent; color: #f7768e; border: 1px solid #4a1c1c;
            padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
            cursor: pointer; font-family: inherit;
        }
        .btn-danger-outline:hover { background: rgba(247,118,142,0.1); }
    </style>
</head>
<body>
<div class="page">
    <%
        const mcOptions = {
            arguingStaff: { A: 'Encourage them', B: 'Temporarily suspend them', C: 'Ignore them', D: 'Join them' },
            escalation: { A: 'Whenever a user disagrees with a warning', B: 'Only when a server boost is threatened', C: 'When dealing with threats of self-harm, doxxing, or severe safety breaches', D: 'Never, staff should handle everything alone' },
            fairDiscipline: { A: 'Punish the new member harshly and ignore the trusted member completely', B: 'Apply the server rules fairly and consistently regardless of how long someone has been in the community', C: 'Ban both users permanently without a warning', D: 'Ask the general chat to vote on whether rules should apply to old members' },
            security: { A: 'Turning off all text channels for everyone', B: 'Requiring Two-Factor Authentication (2FA) for all staff roles and properly configuring channel permissions', C: 'Asking members to politely tell the hacker to stop', D: 'Deleting the entire server immediately' }
        };
        const mcLabel = (field) => {
            const letter = application[field];
            const text = (mcOptions[field] || {})[letter];
            return text ? `${letter} - ${text}` : letter;
        };
    %>

    <a href="/co-owner-applications" class="back">&#8592; Back to All Applications</a>

    <div class="header-row">
        <h1>👑 <%= application.username %></h1>
        <form method="POST" action="/co-owner-applications/<%= application.id %>/delete" onsubmit="return confirm('Delete this application? This cannot be undone.')">
            <button type="submit" class="btn-danger-outline">🗑 Delete Application</button>
        </form>
    </div>


    <div class="app-meta">
        <div class="stat"><span class="label">Time-zone</span><span class="value"><%= application.timezone %></span></div>
        <div class="stat"><span class="label">Age</span><span class="value"><%= application.age %></span></div>
        <div class="stat"><span class="label">Submitted</span><span class="value"><%= new Date(application.submittedAt).toLocaleString('en-GB') %></span></div>
    </div>

    <div class="card">
        <div class="qa-block">
            <div class="qa-question">4. What makes you want this position in this server, other than another staff role?</div>
            <div class="qa-answer"><%= application.motivation %></div>
        </div>
        <div class="qa-block">
            <div class="qa-question">5. Where do you see yourself in 6 months, and what improvements would you make to the server?</div>
            <div class="qa-answer"><%= application.vision %></div>
        </div>
        <div class="qa-block">
            <div class="qa-question">6. How do you handle stress?</div>
            <div class="qa-answer"><%= application.stress %></div>
        </div>
        <div class="qa-block">
            <div class="qa-question">7. What is your past moderator experience in this server?</div>
            <div class="qa-answer"><%= application.experience %></div>
        </div>
        <div class="qa-block">
            <div class="qa-question">8. As a co-owner, or part of any ownership team, how would you handle communicating unpopular decisions to members who disagree?</div>
            <div class="qa-answer"><%= application.unpopularDecisions %></div>
        </div>
        <div class="qa-block">
            <div class="qa-question">9. How do you prefer to receive feedback from the server owner and other staff members when you make a mistake?</div>
            <div class="qa-answer"><%= application.feedback %></div>
        </div>
        <div class="qa-block">
            <div class="qa-question">10. How will you handle being a person of authority, and being a friendly member towards others?</div>
            <div class="qa-answer"><%= application.authorityBalance %></div>
        </div>
        <div class="qa-block">
            <div class="qa-question">11. Two staff members are arguing in general and violating the rules. What would you do?</div>
            <div class="qa-answer mc"><%= mcLabel('arguingStaff') %></div>
        </div>
        <div class="qa-block">
            <div class="qa-question">12. When should a staff member escalate a situation directly to the owner team?</div>
            <div class="qa-answer mc"><%= mcLabel('escalation') %></div>
        </div>
        <div class="qa-block">
            <div class="qa-question">13. A trusted member breaks a minor rule for the first time; a new member breaks a major rule. How should discipline be approached?</div>
            <div class="qa-answer mc"><%= mcLabel('fairDiscipline') %></div>
        </div>
        <div class="qa-block">
            <div class="qa-question">14. Best preventative security measure against a hacked moderator account?</div>
            <div class="qa-answer mc"><%= mcLabel('security') %></div>
        </div>
    </div>

</div>
</body>
</html>
