<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= r.subject %> – <%= botName %> Help Center</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:wght@400..700&display=swap" rel="stylesheet">
    <style>
        :root { --bg:#0c0a1f; --bg2:#171337; --bg3:#0f0d27; --hero:#7c4dff; --text:#f3f1ff; --dim:#8f8abf; --line:#2a2561; --link:#8ecbff; }
        * { box-sizing: border-box; }
        body { margin:0; background:var(--bg); color:var(--text); font:16px/1.6 'Figtree','Segoe UI',system-ui,sans-serif; }
        a { color:var(--link); text-decoration:none; } a:hover { text-decoration:underline; }
        header.bar { background:var(--bg3); border-bottom:1px solid var(--line); }
        .bar-in { max-width:1100px; margin:0 auto; padding:14px 24px; display:flex; align-items:center; gap:18px; }
        .brand { font-weight:700; color:#fff; font-size:17px; text-decoration:none !important; } .brand span { color:var(--dim); font-weight:500; }
        .sp { flex:1; }
        .btn { display:inline-block; background:var(--hero); color:#fff !important; font-weight:600; font-size:14px; padding:9px 18px; border-radius:6px; border:none; cursor:pointer; font-family:inherit; text-decoration:none !important; }
        .btn:hover { background:#6a3df0; }
        .btn.alt { background:transparent; border:1px solid #3a3478; }
        .btn.alt:hover { background:#2a2561; }
        .btn[disabled] { opacity:.55; cursor:not-allowed; }
        .linkbtn { background:none; border:none; color:var(--dim); cursor:pointer; font:inherit; font-size:14px; padding:0; } .linkbtn:hover { color:#fff; }
        .wrap { max-width:1100px; margin:0 auto; padding:34px 24px 70px; }
        .crumb { color:var(--dim); font-size:14px; margin-bottom:18px; }
        h1 { font-size:32px; line-height:1.25; margin:0 0 22px; padding-bottom:22px; border-bottom:1px solid var(--line); word-break:break-word; }
        .layout { display:grid; grid-template-columns:minmax(0,1fr) 320px; gap:36px; align-items:start; }
        .flash { padding:11px 14px; border-radius:8px; font-size:14px; margin-bottom:18px; border:1px solid; }
        .flash.ok { background:rgba(87,242,135,.10); border-color:#3ba55d; color:#5fe3a1; }
        .flash.bad { background:rgba(240,71,71,.12); border-color:#ff6b8a; color:#ffb3c2; }

        .post { display:flex; gap:14px; padding:22px 0; border-bottom:1px solid var(--line); }
        .av { width:42px; height:42px; border-radius:50%; flex-shrink:0; background:#3a3478; color:#fff; font-weight:700; display:flex; align-items:center; justify-content:center; overflow:hidden; font-size:17px; }
        .av img { width:100%; height:100%; object-fit:cover; display:block; }
        .av.staff { background:var(--hero); font-size:20px; }
        .post-main { flex:1; min-width:0; }
        .who { font-weight:600; color:#fff; } .when { color:var(--dim); font-size:14px; margin-top:-2px; }
        .tag { display:inline-block; font-size:11px; font-weight:700; background:var(--hero); color:#fff; padding:1px 7px; border-radius:4px; margin-left:6px; vertical-align:2px; }
        .body { white-space:pre-wrap; word-wrap:break-word; overflow-wrap:anywhere; margin-top:12px; font-size:15.5px; }
        .post.staff { background:linear-gradient(90deg, rgba(88,101,242,.08), transparent 70%); margin:0 -14px; padding-left:14px; padding-right:14px; border-radius:6px; }
        .event { text-align:center; color:var(--dim); font-size:13px; padding:14px 0; border-bottom:1px solid var(--line); }
        .event::before, .event::after { content:''; display:inline-block; width:36px; height:1px; background:var(--line); vertical-align:middle; margin:0 12px; }

        .reply { margin-top:26px; }
        .reply h2 { font-size:18px; margin:0 0 12px; }
        textarea { width:100%; min-height:150px; resize:vertical; background:var(--bg3); color:var(--text); border:1px solid #2a2561; border-radius:8px; padding:12px 14px; font:inherit; font-size:15px; outline:none; }
        textarea:focus { border-color:var(--hero); }
        .actions { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:12px; }
        .count { margin-left:auto; color:var(--dim); font-size:13px; }
        .note { background:var(--bg2); border:1px solid var(--line); border-radius:8px; padding:11px 14px; font-size:14px; color:var(--dim); margin-bottom:14px; }
        .full { background:var(--bg2); border:1px dashed var(--line); border-radius:10px; padding:18px; color:var(--dim); text-align:center; }

        aside.card { background:var(--bg2); border:1px solid var(--line); border-radius:10px; padding:6px 20px; position:sticky; top:20px; }
        .row { display:grid; grid-template-columns:116px 1fr; gap:12px; padding:13px 0; border-bottom:1px solid var(--line); font-size:14px; }
        .row:last-child { border-bottom:none; }
        .row dt { color:var(--dim); } .row dd { margin:0; word-break:break-word; }
        .row.gap { margin-top:6px; border-top:1px solid var(--line); }
        .badge { display:inline-block; font-size:12px; font-weight:700; padding:3px 10px; border-radius:99px; }
        .st-open { background:#1a2e3a; color:#8ecbff; } .st-awaiting { background:#33290f; color:#ffc857; } .st-solved { background:#2a2561; color:#d6d2f5; }
        .hint { color:var(--dim); font-size:12px; margin-top:4px; }
        footer { background:var(--bg3); border-top:1px solid var(--line); padding:26px 24px; color:var(--dim); font-size:13px; text-align:center; } footer a { color:var(--dim); }
        @media (max-width: 860px) { .layout { grid-template-columns:1fr; } aside.card { position:static; order:-1; } h1 { font-size:26px; } }
        h1, h2, h3 { font-family: 'Bricolage Grotesque', 'Segoe UI', system-ui, sans-serif; letter-spacing: -.01em; }
    :focus-visible { outline: 2px solid #ffc857; outline-offset: 2px; }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; scroll-behavior: auto !important; } }
.homebtn { display:inline-flex; align-items:center; gap:7px; color:var(--dim); font-size:14px; font-weight:600; text-decoration:none !important; padding:6px 14px; border:1px solid var(--line); border-radius:999px; } .homebtn:hover { color:#fff; border-color:var(--hero); }
</style>
</head>
<body>
<header class="bar"><div class="bar-in">
    <a class="brand" href="/support"><%= botName %> <span>Help Center</span></a>
    <span class="sp"></span>
    <a class="homebtn" href="/login"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10"/></svg>Home</a>
    <form method="POST" action="/support/logout" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="linkbtn" type="submit">Log out (<%= member.username %>)</button></form>
    <a class="btn" href="/support/request">Submit a request</a>
</div></header>

<div class="wrap">
    <div class="crumb"><a href="/support">Help Center</a> › <a href="/support/my-requests">My Help Requests</a> › <%= r.id %></div>
    <h1><%= r.subject %></h1>

    <div class="layout">
        <main>
            <% if (msg) { %><div class="flash ok"><%= msg %></div><% } %>
            <% if (err) { %><div class="flash bad"><%= err %></div><% } %>

            <% r.messages.forEach(m => { %>
                <% if (m.from === 'system') { %>
                    <div class="event"><%= m.body %> · <time datetime="<%= new Date(m.at).toISOString() %>" data-rel><%= ago(m.at) %></time></div>
                <% } else if (m.from === 'staff') { %>
                    <div class="post staff">
                        <div class="av staff" aria-hidden="true">&#128172;</div>
                        <div class="post-main">
                            <div class="who"><%= botName %> Support <span class="tag">Staff</span></div>
                            <div class="when"><time datetime="<%= new Date(m.at).toISOString() %>" data-full="<%= full(m.at) %>" title="<%= full(m.at) %>"><%= ago(m.at) %></time></div>
                            <div class="body"><%= m.body %></div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="post">
                        <div class="av"><% if (memberAvatar) { %><img src="<%= memberAvatar %>" alt=""><% } else { %><%= String(member.username || '?').charAt(0).toUpperCase() %><% } %></div>
                        <div class="post-main">
                            <div class="who"><%= member.username %></div>
                            <div class="when"><time datetime="<%= new Date(m.at).toISOString() %>" data-full="<%= full(m.at) %>" title="<%= full(m.at) %>"><%= ago(m.at) %></time></div>
                            <div class="body"><%= m.body %></div>
                        </div>
                    </div>
                <% } %>
            <% }) %>

            <section class="reply" id="reply">
                <% if (r.messages.filter(m => m.from !== 'system').length >= (r.ticket ? 150 : 60)) { %>
                    <div class="full">This thread has reached its message limit. Please <a href="/support/request">submit a new request</a> and mention <strong><%= r.id %></strong>.</div>
                <% } else { %>
                    <h2><%= r.status === 'solved' ? 'Need more help?' : 'Add a reply' %></h2>
                    <% if (r.status === 'solved') { %><div class="note">This request is marked as solved. Sending a reply will reopen it.</div><% } %>
                    <form method="POST" action="/support/requests/<%= r.id %>/reply" id="replyForm">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <textarea name="body" id="replyBody" maxlength="<%= limits.max %>" required placeholder="Write your reply…"></textarea>
                        <div class="actions">
                            <button class="btn" type="submit" id="sendBtn"><%= r.status === 'solved' ? 'Reply and reopen' : 'Send reply' %></button>
                            <% if (r.status !== 'solved') { %>
                                <button class="btn alt" type="submit" form="solveForm">Mark as solved</button>
                            <% } %>
                            <span class="count"><span id="chars">0</span> / <%= limits.max %></span>
                        </div>
                    </form>
                    <% if (r.status !== 'solved') { %>
                        <form method="POST" action="/support/requests/<%= r.id %>/solve" id="solveForm" onsubmit="return confirm('Mark this request as solved? You can reopen it by replying.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
                    <% } %>
                    <p class="hint" style="margin-top:14px;">Please don’t include passwords, tokens or login codes. Staff will never ask for them.</p>
                <% } %>
            </section>
        </main>

        <aside class="card">
            <dl style="margin:0;">
                <div class="row"><dt>Requester</dt><dd><%= r.discord %></dd></div>
                <div class="row"><dt>Created</dt><dd><time datetime="<%= new Date(r.createdAt).toISOString() %>" data-full="<%= full(r.createdAt) %>"><%= full(r.createdAt) %></time></dd></div>
                <div class="row"><dt>Last activity</dt><dd><time datetime="<%= new Date(r.updatedAt).toISOString() %>" data-full="<%= full(r.updatedAt) %>"><%= full(r.updatedAt) %></time></dd></div>
                <div class="row gap"><dt>Id</dt><dd>#<%= r.id %></dd></div>
                <div class="row"><dt>Status</dt><dd><span class="badge st-<%= r.status %>"><%= STATUS[r.status].member %></span><div class="hint"><%= STATUS[r.status].memberHint %></div></dd></div>
                <div class="row"><dt>Type of question?</dt><dd><%= r.type %></dd></div>
                <div class="row"><dt>Contact email</dt><dd><%= r.email || 'Not given (staff reply here and on Discord)' %></dd></div>
            </dl>
        </aside>
    </div>
</div>
<footer><a href="/support">Help Center</a> · <a href="/terms">Terms of Service</a> · <a href="/privacy">Privacy Policy</a></footer>

<script>
    // Show dates in the viewer's own time zone (the server-rendered UTC text is the fallback).
    document.querySelectorAll('time[data-full]').forEach(function (t) {
        var d = new Date(t.getAttribute('datetime'));
        if (isNaN(d)) return;
        var local = d.toLocaleString('en-US', { dateStyle: 'long', timeStyle: 'short' });
        if (t.closest('aside')) t.textContent = local; else t.title = local;
    });
    var box = document.getElementById('replyBody'), chars = document.getElementById('chars');
    if (box) box.addEventListener('input', function () { chars.textContent = box.value.length; });
    var form = document.getElementById('replyForm');
    if (form) form.addEventListener('submit', function (e) {
        // only the main "send" submit should lock the button (the solve button posts a different form)
        if (e.submitter && e.submitter.id !== 'sendBtn') return;
        var b = document.getElementById('sendBtn'); b.disabled = true; b.textContent = 'Sending…';
    });
    if (/[?&](msg|err)=/.test(location.search)) { var r = document.getElementById('reply'); if (r) r.scrollIntoView({ block: 'center' }); }
</script>
</body>
</html>
