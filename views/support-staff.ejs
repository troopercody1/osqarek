<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Support requests</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', sans-serif; background-color: #16161e; color: #a9b1d6; padding: 40px 20px; }
        .page { max-width: 880px; margin: 0 auto; }
        a { color: #7aa2f7; text-decoration: none; } a:hover { color: #a9c5ff; }
        a.back { font-size: 13px; display: inline-flex; gap: 6px; margin-bottom: 24px; }
        h1 { color: #7aa2f7; font-size: 22px; font-weight: 600; margin-bottom: 4px; }
        .page-sub { font-size: 13px; color: #565f89; margin-bottom: 20px; }
        .flash { padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 18px; border: 1px solid; }
        .flash.ok  { background: rgba(158,206,106,.1); color: #9ece6a; border-color: #9ece6a; }
        .flash.bad { background: rgba(247,118,142,.1); color: #f7768e; border-color: #f7768e; }
        .card { background: #1a1b26; border: 1px solid #2f3549; border-radius: 12px; overflow: hidden; margin-bottom: 18px; }
        .pad { padding: 18px; }
        .toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
        .toolbar form { display: flex; gap: 8px; flex: 1; min-width: 220px; }
        input[type=text], select, textarea { background: #1a1b26; border: 1px solid #2f3549; color: #c0caf5; padding: 8px 10px; border-radius: 6px; width: 100%; font-family: 'Segoe UI', sans-serif; font-size: 13px; }
        select { width: auto; }
        textarea { min-height: 150px; resize: vertical; line-height: 1.5; }
        input:focus, textarea:focus, select:focus { outline: none; border-color: #7aa2f7; }
        .btn { font-size: 13px; font-weight: 500; padding: 7px 14px; border-radius: 6px; border: 1px solid #2f3549; background: #1a1b26; color: #c0caf5; cursor: pointer; font-family: 'Segoe UI', sans-serif; white-space: nowrap; display: inline-block; }
        .btn:hover { background: #252636; color: #c0caf5; }
        .btn-primary { background: #5865f2; color: #fff; border-color: transparent; } .btn-primary:hover { background: #4752c4; color: #fff; }
        .btn-solve { background: #1a2e1a; color: #9ece6a; border-color: #2c4a2c; } .btn-solve:hover { background: #213a21; color: #b6e28a; }
        .btn.active { border-color: #7aa2f7; color: #7aa2f7; }
        .pill { font-size: 11px; font-weight: 600; padding: 2px 9px; border-radius: 99px; white-space: nowrap; }
        .st-open { background: #1a1f3a; color: #7aa2f7; } .st-awaiting { background: #2e2a1a; color: #e0af68; } .st-solved { background: #1a2e1a; color: #9ece6a; }
        .row { display: flex; align-items: center; gap: 14px; padding: 13px 16px; border-bottom: 1px solid #2f3549; color: inherit; }
        .row:last-child { border-bottom: none; } .row:hover { background: #1f2030; }
        .row-main { flex: 1; min-width: 0; }
        .row-subj { font-size: 13.5px; color: #c0caf5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .row-sub { font-size: 12px; color: #565f89; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .row-end { text-align: right; flex-shrink: 0; font-size: 11px; color: #565f89; line-height: 1.6; }
        .needs .row-subj { font-weight: 600; }
        .empty { padding: 28px; text-align: center; font-size: 13px; color: #565f89; }
        .head { display: flex; gap: 12px; align-items: flex-start; flex-wrap: wrap; margin-bottom: 14px; }
        .head h1 { flex: 1; min-width: 240px; color: #c0caf5; font-size: 19px; }
        .meta { display: grid; grid-template-columns: 110px 1fr; gap: 6px 14px; font-size: 12.5px; padding: 16px 18px; }
        .meta dt { color: #565f89; } .meta dd { color: #a9b1d6; word-break: break-word; }
        .msg { padding: 16px 18px; border-bottom: 1px solid #2f3549; }
        .msg:last-child { border-bottom: none; }
        .msg.staff { background: #1c1e2e; }
        .msg-top { font-size: 12px; color: #565f89; margin-bottom: 8px; display: flex; gap: 8px; align-items: center; }
        .msg-top b { color: #c0caf5; font-weight: 600; font-size: 13px; }
        .tag { font-size: 10px; padding: 1px 7px; border-radius: 99px; background: #1a1f3a; color: #7aa2f7; }
        .msg-body { white-space: pre-wrap; word-wrap: break-word; overflow-wrap: anywhere; font-size: 13.5px; line-height: 1.6; color: #c0caf5; }
        .event { text-align: center; font-size: 11.5px; color: #565f89; padding: 10px; border-bottom: 1px solid #2f3549; }
        label { font-size: 12px; color: #565f89; display: block; margin: 0 0 6px; }
        .reply-actions { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; align-items: center; }
        .small { font-size: 12px; color: #565f89; line-height: 1.6; }
        .warn { background: rgba(224,175,104,.08); border: 1px solid #5a4a28; color: #e0af68; border-radius: 8px; padding: 9px 12px; font-size: 12.5px; margin-bottom: 14px; }
    </style>
</head>
<body>
<div class="page">
    <a href="<%= view === 'list' ? '/settings' : '/settings/support' %>" class="back">&#8592; <%= view === 'list' ? 'Back to Settings' : 'Back to requests' %></a>

    <% if (msg) { %><div class="flash ok">&#9989; <%= msg %></div><% } %>
    <% if (err) { %><div class="flash bad">&#9888; <%= err %></div><% } %>

<% if (view === 'list') { %>
    <h1>Support requests</h1>
    <p class="page-sub">Help Center threads. Replying sets the request to <b>Awaiting member</b>; when the member answers it goes back to <b>Open</b>.</p>

    <div class="toolbar">
        <form method="GET" action="/settings/support">
            <% if (filter !== 'all') { %><input type="hidden" name="status" value="<%= filter %>"><% } %>
            <input type="text" name="q" value="<%= q || '' %>" placeholder="Search id, subject, username, email…">
            <button class="btn" type="submit">Search</button>
        </form>
    </div>
    <div class="toolbar">
        <a class="btn <%= filter === 'all' ? 'active' : '' %>" href="/settings/support">All (<%= counts.all %>)</a>
        <a class="btn <%= filter === 'open' ? 'active' : '' %>" href="/settings/support?status=open">Open (<%= counts.open %>)</a>
        <a class="btn <%= filter === 'awaiting' ? 'active' : '' %>" href="/settings/support?status=awaiting">Awaiting member (<%= counts.awaiting %>)</a>
        <a class="btn <%= filter === 'solved' ? 'active' : '' %>" href="/settings/support?status=solved">Solved (<%= counts.solved %>)</a>
    </div>

    <div class="card">
        <% if (!list.length) { %><div class="empty">No requests here.</div><% } %>
        <% list.forEach(x => { %>
            <a class="row <%= x.status === 'open' ? 'needs' : '' %>" href="/settings/support/<%= x.id %>">
                <div class="row-main">
                    <div class="row-subj"><%= x.subject %></div>
                    <div class="row-sub"><%= x.id %> · <%= x.discord %> · <%= x.type %> · <%= x.messages.filter(m => m.from !== 'system').length %> message<%= x.messages.filter(m => m.from !== 'system').length === 1 ? '' : 's' %></div>
                </div>
                <div class="row-end">
                    <span class="pill st-<%= x.status %>"><%= STATUS[x.status].staff %></span><br>
                    Last activity <%= ago(x.updatedAt) %>
                </div>
            </a>
        <% }) %>
    </div>

<% } else { %>
    <div class="head">
        <h1><%= r.subject %></h1>
        <span class="pill st-<%= r.status %>" style="margin-top:6px;"><%= STATUS[r.status].staff %></span>
    </div>

    <div class="card">
        <dl class="meta">
            <dt>Reference</dt><dd><%= r.id %></dd>
            <dt>Requester</dt><dd><%= r.discord %><% if (r.discordId) { %> <span class="small">(Discord ID <%= r.discordId %>)</span><% } %></dd>
            <dt>Type</dt><dd><%= r.type %></dd>
            <dt>Email</dt><dd><%= r.email || 'Not given' %></dd>
            <dt>Created</dt><dd><%= full(r.createdAt) %></dd>
            <dt>Last activity</dt><dd><%= full(r.updatedAt) %> <span class="small">(<%= ago(r.updatedAt) %>)</span></dd>
        </dl>
    </div>

    <% if (!r.discordId) { %>
        <div class="warn">This request was sent while logged out, so the member <b>can't see this thread on the site</b>. Your reply is only delivered by email<%= r.email ? '' : ' (none was given, so DM them on Discord instead)' %>.</div>
    <% } %>

    <div class="card">
        <% r.messages.forEach(m => { %>
            <% if (m.from === 'system') { %>
                <div class="event"><%= m.body %> · <%= full(m.at) %></div>
            <% } else { %>
                <div class="msg <%= m.from === 'staff' ? 'staff' : '' %>">
                    <div class="msg-top">
                        <b><%= m.name || (m.from === 'staff' ? 'Staff' : r.discord) %></b>
                        <% if (m.from === 'staff') { %><span class="tag">Staff · shown to member as "Support Team"</span><% } else { %><span class="tag">Member</span><% } %>
                        <span><%= full(m.at) %></span>
                    </div>
                    <div class="msg-body"><%= m.body %></div>
                </div>
            <% } %>
        <% }) %>
    </div>

    <form class="card pad" method="POST" action="/settings/support/<%= r.id %>/reply">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="body">Reply to <%= r.discord %></label>
        <textarea id="body" name="body" maxlength="<%= max %>" required placeholder="Write your reply…"></textarea>
        <div class="reply-actions">
            <button class="btn btn-primary" type="submit">Send reply</button>
            <button class="btn btn-solve" type="submit" name="solve" value="1">Send reply &amp; mark solved</button>
            <span class="small" style="margin-left:auto;">The member gets a Discord DM<%= r.email ? ' and an email' : '' %>.</span>
        </div>
    </form>

    <form class="card pad" method="POST" action="/settings/support/<%= r.id %>/status" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="status" style="margin:0;">Change status</label>
        <select id="status" name="status">
            <% ['open', 'awaiting', 'solved'].forEach(k => { %><option value="<%= k %>" <%= r.status === k ? 'selected' : '' %>><%= STATUS[k].staff %></option><% }) %>
        </select>
        <button class="btn" type="submit">Update</button>
    </form>
<% } %>
</div>
</body>
</html>
