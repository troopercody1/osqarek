<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="UTF-8">
    <title><%= stats.botName %> - Dashboard</title>
    <%- include('partials/head') %>
</head>
<body>
    <%
    const activePage = locals.activePage || 'config';
    const ICONS = {
        config: '<circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/>',
        modules: '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>',
        reactions: '<circle cx="12" cy="12" r="9"/><path d="M8.5 14c1 1.5 2.2 2.2 3.5 2.2s2.5-.7 3.5-2.2M9 9.5h.01M15 9.5h.01"/>',
        words: '<circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/>',
        nick: '<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1"/>',
        confess: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h8"/>',
        infractions: '<path d="M6 21V4M6 5h11l-2 4 2 4H6"/>',
        risk: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/>',
        protect: '<path d="M12 4l9 16H3z"/><path d="M12 10v4M12 17h.01"/>',
        lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/>',
        search: '<circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5"/>',
        audit: '<path d="M5 6h14M5 12h14M5 18h9"/>',
        analytics: '<path d="M5 20V10M12 20V4M19 20v-7"/>',
        gift: '<rect x="4" y="10" width="16" height="10" rx="1.5"/><path d="M12 10v10M3 7h18v3H3zM12 7c-2.5 0-4-3-2-3.5S12 7 12 7s.5-3.2 2.5-3S14.5 7 12 7"/>',
        clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
        coin: '<circle cx="12" cy="12" r="9"/><path d="M14.5 9.5c-.5-1-1.5-1.5-2.5-1.5-1.4 0-2.5.8-2.5 2s1.1 1.7 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2c-1 0-2-.5-2.5-1.5M12 6.5V8M12 16v1.5"/>',
        sliders: '<path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1"/><circle cx="15" cy="6" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="18" r="2"/>',
        terminal: '<path d="M4 5h16v14H4zM8 10l3 2-3 2M13 15h3"/>',
        book: '<path d="M5 4h10a3 3 0 013 3v13H8a3 3 0 01-3-3z"/><path d="M5 17a3 3 0 013-3h10"/>',
        wrench: '<path d="M14.5 6.5a4 4 0 005 5l-8.8 8.8a2 2 0 01-2.8-2.8z"/><path d="M14.5 6.5l3-3a4 4 0 01-3 3"/>',
        out: '<path d="M10 5H5v14h5M15 8l4 4-4 4M19 12H9"/>'
    };
    const ico = (n) => '<svg class="ico" viewBox="0 0 24 24" aria-hidden="true">' + (ICONS[n] || '') + '</svg>';
    const isAdmin = !!(user && user.id === 'admin');
    const NAV = [
        ['Server', [
            ['/config', 'config', 'config', 'Overview'],
            ['/modules', 'modules', 'modules', 'Modules'],
            ['/reaction-roles', 'reaction-roles', 'reactions', 'Reaction roles'],
            ['/banned-words', 'banned-words', 'words', 'Banned words'],
            ['/nickname-guard', 'nickname-guard', 'nick', 'Nickname guard'],
            ['/confessions', 'confessions', 'confess', 'Confessions'],
        ]],
        ['Moderation', [
            ['/infractions', 'infractions', 'infractions', 'Infractions'],
            ['/risk-manager', 'risk-manager', 'risk', 'Risk manager'],
            ['/protection', 'fx-protection', 'protect', 'Protection'],
            ['/lockdown', 'fx-lockdown', 'lock', 'Lockdown & drills'],
            ['/cases', 'fx-cases', 'search', 'Case search'],
            ['/audit', 'fx-audit', 'audit', 'Audit log'],
        ]],
        ['Community', [
            ['/community', 'fx-community', 'gift', 'Giveaways & polls'],
            ['/ecodrops', 'fx-ecodrops', 'coin', 'Eco drops'],
            ['/timed', 'fx-timed', 'clock', 'Timed actions'],
            ['/analytics', 'fx-analytics', 'analytics', 'Analytics'],
        ]],
        ['Admin', [
            ['/features', 'fx-features', 'sliders', 'Feature settings'],
            ['/system-logs', 'system-logs', 'terminal', 'System logs'],
        ].concat(isAdmin ? [['/helpcenter', 'fx-helpcenter', 'book', 'Help center']] : [])],
    ];
    const PAGES = {
        config: ['Overview', 'Welcome channels and a quick look at how the server is set up.'],
        modules: ['Modules', 'Turn whole parts of the bot on or off. Changes apply immediately.'],
        'reaction-roles': ['Reaction roles', 'Role panels members pick from with emoji.'],
        'banned-words': ['Banned words', 'Messages containing these are removed and escalated by auto-mod.'],
        'nickname-guard': ['Nickname guard', 'Keep nicknames readable and catch rule-breaking renames.'],
        confessions: ['Confessions', 'Review anonymous posts and manage who is blocked from posting.'],
        infractions: ['Infractions', 'Every warn, mute and ban on record.'],
        'risk-manager': ['Risk manager', 'Members flagged as risky, waiting on a decision.'],
        'fx-protection': ['Protection', 'Raid defence, ban-evasion checks and impersonation alerts.'],
        'fx-lockdown': ['Lockdown & drills', 'Lock the server down fast and rehearse doing it.'],
        'fx-cases': ['Case search', 'Look up any case by member, type or reason.'],
        'fx-audit': ['Audit log', 'What staff and the bot changed, and when.'],
        'fx-community': ['Giveaways & polls', 'Start, end and review giveaways and polls.'],
        'fx-ecodrops': ['Eco drops', 'Scheduled and manual drops that members claim with a button.'],
        'fx-timed': ['Timed actions', 'Bans, mutes and role changes that undo themselves later.'],
        'fx-analytics': ['Analytics', 'Messages, joins and activity over time.'],
        'fx-features': ['Feature settings', 'Every feature\'s options in one place.'],
        'system-logs': ['System logs', 'Live bot output and recent errors.'],
        'fx-helpcenter': ['Help center', 'Edit the popular articles and review support requests.'],
        terminal: ['System logs', 'Live bot output and recent errors.']
    };
    const pg = PAGES[activePage] || ['Dashboard', ''];
    const online = stats.botStatus === 'ONLINE';
    %>
    <aside class="sidebar">
        <a class="brand" href="/config">
            <b>OsQarek's Universe<small>Bot dashboard</small></b>
        </a>
        <nav>
        <% NAV.forEach(function (g) { %>
            <div class="nav-group"><%= g[0] %></div>
            <% g[1].forEach(function (l) { %><a href="<%= l[0] %>" class="tab-btn<%= activePage === l[1] ? ' active' : '' %>"<%- activePage === l[1] ? ' aria-current="page"' : '' %>><%- ico(l[2]) %><%= l[3] %></a>
            <% }) %>
        <% }) %>
        </nav>
        <div class="side-foot">
            <% if (isAdmin) { %><a href="/settings" class="sidebar-link"><%- ico('wrench') %>Site settings</a><% } %>
            <form action="/logout" method="POST" style="margin:0;"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="sidebar-link logout"><%- ico('out') %>Log out</button></form>
        </div>
    </aside>

    <main class="main-content">
        <header class="page-head">
            <div>
                <h1><%= pg[0] %></h1>
                <% if (pg[1]) { %><p><%= pg[1] %></p><% } %>
            </div>
            <div class="pulse<%= online ? '' : ' off' %>" title="Bot status"><i></i><span><%= online ? 'Online' : 'Offline' %></span><span><%= stats.ping %></span><span>up <%= stats.uptime %></span></div>
        </header>

        <!-- ═══════════════ CONFIGURATION ═══════════════ -->
        <div id="dashboard" class="tab-content<%= (locals.activeTab || 'dashboard') === 'dashboard' ? ' active' : '' %>">
            <% const modKeys = ['aiEnabled','musicEnabled','modmailEnabled','automodEnabled','welcomeEnabled','remindersEnabled','moderationEnabled','utilitiesEnabled','funEnabled','quizEnabled','staffToolsEnabled','tempChannelsEnabled']; const modsOn = modKeys.filter(k => db[k] !== false).length; %>
            <div class="grid-stats">
                <a class="card-stat" href="/infractions"><div class="val"><%= (db.cases || []).length.toLocaleString() %></div><h3>Infractions on record</h3></a>
                <a class="card-stat" href="/modules"><div class="val"><%= modsOn %> <span style="font-size:1rem;color:var(--muted);font-weight:500">of <%= modKeys.length %></span></div><h3>Modules switched on</h3></a>
                <a class="card-stat" href="/banned-words"><div class="val"><%= (bannedWords || []).length.toLocaleString() %></div><h3>Banned words</h3></a>
                <div class="card-stat"><div class="val"><%= Number(stats.totalUsers || 0).toLocaleString() %></div><h3>Members the bot can see</h3></div>
            </div>
            <div class="panel">
                <h2>Welcome and goodbye channels</h2>
                <form action="/update-settings" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label>Welcome channel ID</label><input name="welcomeChannel" value="<%= settings.welcomeChannel || '' %>">
                    <label style="margin-top:10px; display:block">Goodbye channel ID</label><input name="goodbyeChannel" value="<%= settings.goodbyeChannel || '' %>">
                    <button type="submit" class="btn-submit">Save changes</button>
                </form>
            </div>
        </div>

        <!-- ═══════════════ MODULES ═══════════════ -->
        <div id="modules" class="tab-content<%= (locals.activeTab || 'dashboard') === 'modules' ? ' active' : '' %>">

            <div class="panel">

                <!-- AI Replies -->
                <div class="module-row">
                    <div class="module-icon" style="background:#211a52;">🤖</div>
                    <div class="module-body">
                        <div class="module-title">AI</div>
                        <div class="module-desc">Controls AI mention replies plus AI-powered slash commands like <code>/summarize</code> and <code>/ask-rules</code>.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.aiEnabled !== false ? 'on' : 'off' %>">
                            <%= db.aiEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="module" value="aiEnabled">
                            <button type="submit"
                                    class="mod-toggle <%= db.aiEnabled !== false ? 'on' : '' %>"
                                    title="Toggle AI"
                                    aria-label="Toggle AI"></button>
                        </form>
                    </div>
                </div>

                <!-- Music -->
                <div class="module-row">
                    <div class="module-icon" style="background:#0f2c22;">🎵</div>
                    <div class="module-body">
                        <div class="module-title">Music</div>
                        <div class="module-desc">Controls the full <code>/music</code> command group: join, play, skip, queue, pause, resume, volume, leave, autoplay, 24/7, and clear.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.musicEnabled !== false ? 'on' : 'off' %>">
                            <%= db.musicEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="module" value="musicEnabled">
                            <button type="submit"
                                    class="mod-toggle <%= db.musicEnabled !== false ? 'on' : '' %>"
                                    title="Toggle Music"
                                    aria-label="Toggle Music"></button>
                        </form>
                    </div>
                </div>

                <!-- Modmail -->
                <div class="module-row">
                    <div class="module-icon" style="background:#33290f;">📨</div>
                    <div class="module-body">
                        <div class="module-title">Modmail</div>
                        <div class="module-desc">Relays DMs sent to the bot to the configured mod-log channel with a reply button.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.modmailEnabled !== false ? 'on' : 'off' %>">
                            <%= db.modmailEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="module" value="modmailEnabled">
                            <button type="submit"
                                    class="mod-toggle <%= db.modmailEnabled !== false ? 'on' : '' %>"
                                    title="Toggle Modmail"
                                    aria-label="Toggle Modmail"></button>
                        </form>
                    </div>
                </div>

                <!-- Auto-Mod -->
                <div class="module-row">
                    <div class="module-icon" style="background:#34152a;">🚨</div>
                    <div class="module-body">
                        <div class="module-title">Auto-Mod</div>
                        <div class="module-desc">Scans messages for banned words and applies escalation actions automatically.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.automodEnabled !== false ? 'on' : 'off' %>">
                            <%= db.automodEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="module" value="automodEnabled">
                            <button type="submit"
                                    class="mod-toggle <%= db.automodEnabled !== false ? 'on' : '' %>"
                                    title="Toggle Auto-Mod"
                                    aria-label="Toggle Auto-Mod"></button>
                        </form>
                    </div>
                </div>

                <!-- Welcome & Goodbye -->
                <div class="module-row">
                    <div class="module-icon" style="background:#1e1a45;">👋</div>
                    <div class="module-body">
                        <div class="module-title">Welcome &amp; Goodbye</div>
                        <div class="module-desc">Posts an inverted-colour welcome image and a greyscale goodbye image when members join or leave.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.welcomeEnabled !== false ? 'on' : 'off' %>">
                            <%= db.welcomeEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="module" value="welcomeEnabled">
                            <button type="submit"
                                    class="mod-toggle <%= db.welcomeEnabled !== false ? 'on' : '' %>"
                                    title="Toggle Welcome/Goodbye"
                                    aria-label="Toggle Welcome/Goodbye"></button>
                        </form>
                    </div>
                </div>

                <!-- Reminders -->
                <div class="module-row">
                    <div class="module-icon" style="background:#211a52;">⏰</div>
                    <div class="module-body">
                        <div class="module-title">Reminders</div>
                        <div class="module-desc">Controls <code>/reminder</code> and the reminder delivery loop for due reminders.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.remindersEnabled !== false ? 'on' : 'off' %>">
                            <%= db.remindersEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="module" value="remindersEnabled">
                            <button type="submit"
                                    class="mod-toggle <%= db.remindersEnabled !== false ? 'on' : '' %>"
                                    title="Toggle Reminders"
                                    aria-label="Toggle Reminders"></button>
                        </form>
                    </div>
                </div>

                <!-- Moderation -->
                <div class="module-row">
                    <div class="module-icon" style="background:#34152a;">⚖️</div>
                    <div class="module-body">
                        <div class="module-title">Moderation</div>
                        <div class="module-desc">Controls moderation actions: <code>/mod</code>, <code>/warn</code>, mute, unmute, slowmode, cases, reaction roles, roles, announcements, and nickname tools.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.moderationEnabled !== false ? 'on' : 'off' %>">
                            <%= db.moderationEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="module" value="moderationEnabled">
                            <button type="submit" class="mod-toggle <%= db.moderationEnabled !== false ? 'on' : '' %>" aria-label="Toggle Moderation"></button>
                        </form>
                    </div>
                </div>

                <!-- Utilities -->
                <div class="module-row">
                    <div class="module-icon" style="background:#211a52;">🔧</div>
                    <div class="module-body">
                        <div class="module-title">Utilities</div>
                        <div class="module-desc">Controls general tools: ping, serverinfo, userinfo, pfp, poll, suggest, random, afk, socials, emoji names, and latest-update.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.utilitiesEnabled !== false ? 'on' : 'off' %>">
                            <%= db.utilitiesEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="module" value="utilitiesEnabled">
                            <button type="submit" class="mod-toggle <%= db.utilitiesEnabled !== false ? 'on' : '' %>" aria-label="Toggle Utilities"></button>
                        </form>
                    </div>
                </div>

                <!-- Fun -->
                <div class="module-row">
                    <div class="module-icon" style="background:#33290f;">🎲</div>
                    <div class="module-body">
                        <div class="module-title">Fun</div>
                        <div class="module-desc">Controls <code>/fun</code>, ship, and prank commands like ban-prank, keyboard-fix, nuke-server, reset-levels, and nerd-mode.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.funEnabled !== false ? 'on' : 'off' %>">
                            <%= db.funEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="module" value="funEnabled">
                            <button type="submit" class="mod-toggle <%= db.funEnabled !== false ? 'on' : '' %>" aria-label="Toggle Fun"></button>
                        </form>
                    </div>
                </div>

                <!-- Quiz -->
                <div class="module-row">
                    <div class="module-icon" style="background:#0f2c22;">🧠</div>
                    <div class="module-body">
                        <div class="module-title">Quiz</div>
                        <div class="module-desc">Custom quiz creation and trivia games (states, countries, canada) with a leaderboard.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.quizEnabled !== false ? 'on' : 'off' %>">
                            <%= db.quizEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="module" value="quizEnabled">
                            <button type="submit" class="mod-toggle <%= db.quizEnabled !== false ? 'on' : '' %>" aria-label="Toggle Quiz"></button>
                        </form>
                    </div>
                </div>

                <!-- Staff Tools -->
                <div class="module-row">
                    <div class="module-icon" style="background:#211a52;">🛠️</div>
                    <div class="module-body">
                        <div class="module-title">Staff Tools</div>
                        <div class="module-desc">Controls staff-only tools: staffstats, syncstats, messagereset, staffdm, ping-all-staff, LOA, strikes, and notes.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.staffToolsEnabled !== false ? 'on' : 'off' %>">
                            <%= db.staffToolsEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="module" value="staffToolsEnabled">
                            <button type="submit" class="mod-toggle <%= db.staffToolsEnabled !== false ? 'on' : '' %>" aria-label="Toggle Staff Tools"></button>
                        </form>
                    </div>
                </div>

                <!-- Temp Channels -->
                <div class="module-row">
                    <div class="module-icon" style="background:#0f2c2c;">🎛️</div>
                    <div class="module-body">
                        <div class="module-title">Temp Channels</div>
                        <div class="module-desc">Controls the "Create Temp Channel" button/modal and the full <code>/channel</code> command group (add-voice, delete, member-add, member-delete).</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.tempChannelsEnabled !== false ? 'on' : 'off' %>">
                            <%= db.tempChannelsEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="module" value="tempChannelsEnabled">
                            <button type="submit" class="mod-toggle <%= db.tempChannelsEnabled !== false ? 'on' : '' %>" aria-label="Toggle Temp Channels"></button>
                        </form>
                    </div>
                </div>

            </div>
        </div>

<!-- ═══════════════ INFRACTIONS ═══════════════ -->
<div id="infractions" class="tab-content<%= (locals.activeTab || 'dashboard') === 'infractions' ? ' active' : '' %>">
    <div class="panel">
        <h2>Infraction Database Registry</h2>

        <!-- Search + Filters -->
        <div class="toolbar">
            <form action="/admin/search" method="GET" class="search-bar">
                <input type="text" name="q" placeholder="Search cases...">
            </form>

            <div class="filter-buttons">
                <a href="/admin/filter/WARN">WARN</a>
                <a href="/admin/filter/BAN">BAN</a>
                <a href="/admin/filter/MUTE">MUTE</a>
                <a href="/admin/filter/SOFTBAN">SOFTBAN</a>
                <a href="/admin?tab=infractions">Reset</a>
            </div>
        </div>

        <!-- Case Creation -->
        <form action="/create-case" method="POST" class="create-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="user" placeholder="User" required>
            <input type="text" name="userId" placeholder="User ID" required>
            <input type="text" name="type" placeholder="Type (WARN/BAN/MUTE)" required>
            <input type="text" name="reason" placeholder="Reason" required>
            <button class="btn-submit">Create Case</button>
        </form>

        <% if (cases.length === 0) { %>
            <p style="color: #8f8abf;">No records found.</p>
        <% } else { %>

        <!-- Infraction Table -->
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>User</th>
                    <th>Type</th>
                    <th>Reason</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                <% cases.forEach((item) => { %>
                <tr>
                    <td style="color: #8ecbff;">#<%= item.id %></td>

                    <td>
                        <%= item.user || item.userId %>
                        <br>
                        <a href="/admin/user/<%= item.userId %>" class="history-link">View History</a>
                    </td>

                    <!-- Color-coded type -->
                    <td class="type-<%= item.type %>">
                        <strong><%= item.type %></strong>
                    </td>

                    <td>
                        <form action="/edit-case/<%= item.id %>" method="POST" style="display:flex; gap:8px;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="text" name="reason" value="<%= item.reason %>">
                            <button type="submit" class="btn-submit">Update</button>
                        </form>
                    </td>

                    <td>
                        <form action="/delete-case/<%= item.id %>" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="btn-delete">Delete</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>

        <% } %>

        <!-- Pagination -->
        <% if (typeof totalPages !== 'undefined' && totalPages) { %>
        <div class="pagination">
            <% for (let i = 1; i <= totalPages; i++) { %>
                <a href="/admin/page/<%= i %>" class="<%= (typeof page !== 'undefined' && page === i) ? 'active-page' : '' %>">
                    <%= i %>
                </a>
            <% } %>
        </div>
        <% } %>

    </div>
</div>


        <!-- ═══════════════ RISK MANAGER ═══════════════ -->
        <div id="risk-manager" class="tab-content<%= (locals.activeTab || 'dashboard') === 'risk-manager' ? ' active' : '' %>">
            <div class="panel">
                <h2>Member Risk Assessment</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Member Tag</th>
                            <th>Risk Score</th>
                            <th>Reason</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (members && members.length > 0) { %>
                            <% members.forEach(member => { %>
                                <% 
                                    let risk = 10;
                                    let reasons = [];
                                    if (member.joinedTimestamp > (Date.now() - 604800000)) { risk += 40; reasons.push("Joined < 7d"); }
                                    const discordEpoch = 1420070400000;
                                    const userId = BigInt(member.id);
                                    const creationTimestamp = Number((userId >> 22n) + BigInt(discordEpoch));
                                    const accountAgeYears = (Date.now() - creationTimestamp) / (1000 * 60 * 60 * 24 * 365);
                                    if (accountAgeYears < 1) { risk += 35; reasons.push("Acct < 1yr"); }
                                    if (!member.user.avatar) { risk += 15; reasons.push("No Avatar"); }
                                %>
                                <tr>
                                    <td><%= member.user.tag %></td>
                                    <td>
                                        <span style="color: <%= risk >= 60 ? '#ff6b8a' : '#5fe3a1' %>;">
                                            <%= risk %>/100 (<%= risk >= 60 ? 'High' : 'Low' %>)
                                        </span>
                                    </td>
                                    <td><%= reasons.length > 0 ? reasons.join(', ') : "Verified Account" %></td>
                                    <td>
                                        <form action="/review-risk/<%= member.id %>" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn-submit">Review</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="4">No members found or intent not enabled.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ═══════════════ BANNED WORDS ═══════════════ -->
        <div id="banned-words" class="tab-content<%= (locals.activeTab || 'dashboard') === 'banned-words' ? ' active' : '' %>">
            <div class="panel">
                <h2>Banned Words</h2>
                <p style="color:#8f8abf; font-size:0.85rem; margin-top:-10px;">
                    Messages containing any of these words are automatically deleted and escalated by Auto-Mod.
                </p>

                <div>
                    <% if (bannedWords && bannedWords.length > 0) { %>
                        <% bannedWords.forEach(word => { %>
                            <span class="word-chip">
                                <%= word %>
                                <form action="/banned-words/remove" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="word" value="<%= word %>">
                                    <button type="submit" title="Remove">✕</button>
                                </form>
                            </span>
                        <% }) %>
                    <% } else { %>
                        <p style="color:#8f8abf;">No banned words configured yet.</p>
                    <% } %>
                </div>

                <form action="/banned-words/add" method="POST" class="add-word-row"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input name="word" placeholder="Add a word to the filter..." required>
                    <button type="submit" class="btn-submit">Add</button>
                </form>
            </div>
        </div>


        <!-- ═══════════════ NICKNAME GUARD ═══════════════ -->
        <% const ng = locals.nickGuard || { config: { enabled: false, minTypeableChars: 3, allowNonLatin: false, checkBannedWords: false, dmUser: true }, log: [], lastScan: null, running: false }; %>
        <div id="nickname-guard" class="tab-content<%= (locals.activeTab || 'dashboard') === 'nickname-guard' ? ' active' : '' %>">
            <div class="panel">
                <h2>Nickname Guard</h2>
                <p style="color:#8f8abf; font-size:0.85rem; margin-top:-10px;">
                    Finds nicknames people can't realistically @-ping (fancy fonts, symbols, etc.) and renames them to
                    <code>ModeratedNickname#1234</code>. Existing members are swept every time the bot starts; new members are checked when they join.
                </p>

                <form action="/nickname-guard/settings" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label class="ng-row">
                        <input type="checkbox" name="enabled" <%= ng.config.enabled ? 'checked' : '' %>>
                        <div><div class="ng-title">Enabled</div><div class="ng-desc">Nothing is checked or renamed while this is off.</div></div>
                    </label>
                    <div class="ng-row">
                        <input type="number" name="minTypeableChars" min="1" max="20" value="<%= ng.config.minTypeableChars %>">
                        <div><div class="ng-title">Minimum typeable characters</div><div class="ng-desc">Letters/numbers a person could type on a normal keyboard (accents like é count). Names with fewer are renamed.</div></div>
                    </div>
                    <label class="ng-row">
                        <input type="checkbox" name="allowNonLatin" <%= ng.config.allowNonLatin ? 'checked' : '' %>>
                        <div><div class="ng-title">Allow non-Latin scripts</div><div class="ng-desc">Count Cyrillic, Arabic, CJK, etc. letters as pingable. Fancy-font lookalikes (𝓯𝓪𝓷𝓬𝔂, ｆｕｌｌｗｉｄｔｈ) are still flagged.</div></div>
                    </label>
                    <label class="ng-row">
                        <input type="checkbox" name="checkBannedWords" <%= ng.config.checkBannedWords ? 'checked' : '' %>>
                        <div><div class="ng-title">Also flag banned words</div><div class="ng-desc">Uses the list on the Banned Words page.</div></div>
                    </label>
                    <label class="ng-row">
                        <input type="checkbox" name="dmUser" <%= ng.config.dmUser ? 'checked' : '' %>>
                        <div><div class="ng-title">DM members when renamed</div><div class="ng-desc">Sends them a short explanation.</div></div>
                    </label>
                    <button type="submit" class="btn-submit">Save Settings</button>
                </form>
            </div>

            <div class="panel">
                <h2>Scan Members</h2>
                <p style="color:#8f8abf; font-size:0.85rem; margin-top:-10px;">Preview shows who would be renamed without changing anything. Uses the saved settings above.</p>
                <div class="ng-btn-row">
                    <form action="/nickname-guard/scan" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="apply" value="0"><button type="submit" class="btn-submit btn-secondary" <%= ng.running ? 'disabled' : '' %>>Preview</button></form>
                    <form action="/nickname-guard/scan" method="POST" onsubmit="return confirm('Rename every flagged member now?');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="apply" value="1"><button type="submit" class="btn-submit" <%= ng.running ? 'disabled' : '' %>>Scan &amp; Rename Now</button></form>
                </div>

                <% if (ng.lastScan) { const sc = ng.lastScan; %>
                    <p style="margin-top:18px;">
                        <span class="ng-pill"><%= sc.status %></span>
                        <%= sc.apply ? 'Rename run' : 'Preview' %> (<%= sc.source %>) &middot; started <%= new Date(sc.startedAt).toLocaleString() %>
                        <% if (sc.error) { %><br><span style="color:#ff6b8a;">Error: <%= sc.error %></span><% } %>
                    </p>
                    <p>Scanned <b><%= sc.scanned %></b> &middot; Flagged <b><%= sc.flagged.length %></b>
                        <% if (sc.apply) { %> &middot; Renamed <b><%= sc.renamed %></b> &middot; Couldn't manage <b><%= sc.unmanageable %></b> &middot; Failed <b><%= sc.failed %></b><% } %></p>
                    <% if (sc.flagged.length) { %>
                        <table>
                            <tr><th>Member</th><th>Current name</th><th>Reason</th><th>Result</th></tr>
                            <% sc.flagged.slice(0, 100).forEach(f => { %>
                                <tr><td><%= f.tag %></td><td><%= f.name %></td><td><%= f.reason %></td><td><%= f.outcome %></td></tr>
                            <% }) %>
                        </table>
                        <% if (sc.flagged.length > 100) { %><p style="color:#8f8abf;">Showing first 100 of <%= sc.flagged.length %>.</p><% } %>
                    <% } %>
                <% } else { %>
                    <p style="color:#8f8abf; margin-top:18px;">No scan has run since the bot started.</p>
                <% } %>
                <% if (ng.running) { %><script>setTimeout(() => location.reload(), 4000);</script><% } %>
            </div>

            <div class="panel">
                <h2>Recent Renames</h2>
                <% if (ng.log.length) { %>
                    <table>
                        <tr><th>When</th><th>Member</th><th>Was</th><th>Reason</th><th>Source</th></tr>
                        <% ng.log.forEach(l => { %>
                            <tr><td><%= new Date(l.ts).toLocaleString() %></td><td><%= l.tag %></td><td><%= l.before %></td><td><%= l.reason %></td><td><%= l.source %></td></tr>
                        <% }) %>
                    </table>
                <% } else { %>
                    <p style="color:#8f8abf;">Nothing renamed yet.</p>
                <% } %>
            </div>
        </div>

        <%- include('partials/features') %>

        <!-- ═══════════════ CONFESSIONS ═══════════════ -->
        <div id="confessions" class="tab-content<%= (locals.activeTab || 'dashboard') === 'confessions' ? ' active' : '' %>">
            <div class="panel">
                <h2>Confessions</h2>
                <p style="color:#8f8abf; font-size:0.85rem; margin-top:-10px;">
                    Members post with <code>/confess</code>. The public post is anonymous; authors are shown below for staff only.
                </p>
                <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:14px;">
                    <div class="panel" style="flex:1; min-width:160px; margin:0;"><div style="color:#8f8abf; font-size:11px; ">Total posted</div><div style="font-size:22px; color:#f3f1ff; font-weight:700;"><%= confessionTotal %></div></div>
                    <div class="panel" style="flex:1; min-width:160px; margin:0;"><div style="color:#8f8abf; font-size:11px; ">Public channel</div><div style="color:<%= confessionConfig.channel ? '#5fe3a1' : '#ff6b8a' %>; font-weight:600;"><%= confessionConfig.channel || 'Not set (CONFESSION_CHANNEL)' %></div></div>
                    <div class="panel" style="flex:1; min-width:160px; margin:0;"><div style="color:#8f8abf; font-size:11px; ">Staff log channel</div><div style="color:<%= confessionConfig.logs ? '#5fe3a1' : '#ff6b8a' %>; font-weight:600;"><%= confessionConfig.logs || 'Not set (CONFESSION_LOGS)' %></div></div>
                </div>
            </div>

            <div class="panel">
                <h2>Disallowed Users</h2>
                <p style="color:#8f8abf; font-size:0.85rem; margin-top:-10px;">These users can't use <code>/confess</code>. Staff can also use <code>/confession disallow</code> / <code>allow</code> in Discord.</p>
                <% if (confessionBans.length === 0) { %>
                    <p style="color:#8f8abf;">Nobody is disallowed.</p>
                <% } else { %>
                <table>
                    <thead><tr><th>User</th><th>Reason</th><th>By</th><th>Date</th><th></th></tr></thead>
                    <tbody>
                    <% confessionBans.forEach(b => { %>
                        <tr>
                            <td><%= b.username || b.userId %><br><span style="color:#8f8abf; font-size:11px;"><%= b.userId %></span></td>
                            <td><%= b.reason %></td>
                            <td><%= b.by %></td>
                            <td><%= new Date(b.at).toLocaleDateString('en-GB') %></td>
                            <td>
                                <form action="/confessions/allow" method="POST" style="margin:0;"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="userId" value="<%= b.userId %>">
                                    <button type="submit" class="btn-submit" style="margin:0;">Allow</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
                <% } %>
                <form action="/confessions/disallow" method="POST" class="add-word-row"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input name="userId" placeholder="Discord user ID to disallow..." required pattern="\d{15,25}">
                    <input name="reason" placeholder="Reason (optional)" maxlength="300">
                    <button type="submit" class="btn-submit">Disallow</button>
                </form>
            </div>

            <div class="panel">
                <h2>Recent Confessions <span style="color:#8f8abf; font-size:12px; font-weight:400;">(last 50 · staff-only author view)</span></h2>
                <% if (recentConfessions.length === 0) { %>
                    <p style="color:#8f8abf;">No confessions have been posted yet.</p>
                <% } else { %>
                <table>
                    <thead><tr><th>#</th><th>Confession</th><th>Author</th><th>Posted</th><th></th></tr></thead>
                    <tbody>
                    <% recentConfessions.forEach(c => { const banned = confessionBans.some(b => b.userId === c.userId); %>
                        <tr>
                            <td>#<%= c.number %></td>
                            <td style="max-width:360px; white-space:pre-wrap; word-break:break-word;"><%= c.text %></td>
                            <td><%= c.username %><br><span style="color:#8f8abf; font-size:11px;"><%= c.userId %></span></td>
                            <td><%= new Date(c.at).toLocaleString('en-GB') %><br><a href="<%= c.url %>" target="_blank" rel="noopener" style="color:#a58bff; font-size:12px;">View</a></td>
                            <td>
                                <% if (banned) { %>
                                    <span style="color:#ff6b8a; font-size:12px;">Disallowed</span>
                                <% } else { %>
                                    <form action="/confessions/disallow" method="POST" style="margin:0;" onsubmit="return confirm('Disallow this author from /confess?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="userId" value="<%= c.userId %>">
                                        <input type="hidden" name="reason" value="Confession #<%= c.number %>">
                                        <button type="submit" class="btn-submit" style="margin:0; background:#34152a; color:#ff6b8a;">Disallow</button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>

        <!-- ═══════════════ SYSTEM LOGS ═══════════════ -->
        <div id="terminal" class="tab-content<%= (locals.activeTab || 'dashboard') === 'terminal' ? ' active' : '' %>">
            <div class="panel">
                <h2>System Logs</h2>
                <div class="terminal-box">
                    <% if (logs && logs.length > 0) { %>
                        <% logs.slice().reverse().forEach(entry => { %>
                            <div class="log">[<%= entry.time %>] <%= entry.text %></div>
                        <% }) %>
                    <% } else { %>
                        <div style="color:#8f8abf;">No logs recorded yet.</div>
                    <% } %>
                </div>
            </div>

            <div class="panel">
                <h2>Errors</h2>
                <div class="terminal-box">
                    <% if (errors && errors.length > 0) { %>
                        <% errors.slice().reverse().forEach(entry => { %>
                            <div class="err">[<%= entry.time %>] <%= entry.text %></div>
                        <% }) %>
                    <% } else { %>
                        <div style="color:#8f8abf;">No errors recorded yet.</div>
                    <% } %>
                </div>
            </div>
        </div>

    </main>

    <!--
        Each sidebar item is now a real page (/config, /modules, /infractions,
        /risk-manager, /reaction-roles, /banned-words, /system-logs) rendered
        server-side, so the correct tab-content/tab-btn is already marked
        "active" above — no client-side tab-switching JS needed anymore.
    -->
    <script>
        // Kept for backwards compatibility with any inline onclick markup that
        // might still reference it; normal navigation now happens via <a href>.
        function openTab(evt, tabName) {
            window.location.href = '/' + ({
                dashboard: 'config',
                modules: 'modules',
                infractions: 'infractions',
                'risk-manager': 'risk-manager',
                'banned-words': 'banned-words',
                'nickname-guard': 'nickname-guard',
                terminal: 'system-logs',
                confessions: 'confessions',
            }[tabName] || 'config');
        }
    </script>
</body>
</html>
