<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="UTF-8">
    <title><%= stats.botName %> - Dashboard</title>
    <style>
        :root { --sidebar-bg: #1a1b26; --main-bg: #16161e; --accent: #7aa2f7; --card-bg: #24283b; --text: #a9b1d6; }
        body { font-family: 'Segoe UI', sans-serif; background-color: var(--main-bg); color: var(--text); margin: 0; display: flex; height: 100vh; }
        
        /* Sidebar */
        .sidebar { width: 260px; background: var(--sidebar-bg); border-right: 1px solid #2f3549; display: flex; flex-direction: column; padding: 20px; }
        .sidebar h2 { color: var(--accent); font-size: 1.2rem; margin-bottom: 2rem; }
        .tab-btn { background: transparent; border: none; color: var(--text); padding: 12px 15px; border-radius: 6px; text-align: left; cursor: pointer; font-weight: bold; margin-bottom: 5px; transition: 0.2s; width: 100%; }
        .tab-btn:hover, .tab-btn.active { background: #2f3549; color: var(--accent); }
        
        /* Main Content */
        .main-content { flex: 1; padding: 40px; overflow-y: auto; }
        .panel { background: var(--card-bg); padding: 25px; border-radius: 8px; border: 1px solid #2f3549; margin-bottom: 25px; }
        h2 { color: #fff; font-size: 1.4rem; margin-top: 0; }
        
        .grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 25px; }
        .card-stat { background: var(--card-bg); padding: 20px; border-radius: 6px; border: 1px solid #2f3549; }
        .card-stat h3 { font-size: 0.75rem; color: #7dcfff; text-transform: uppercase; margin: 0; }
        .card-stat .val { font-size: 1.5rem; font-weight: bold; color: #c0caf5; margin-top: 5px; }
        
        input { background: #16161e; border: 1px solid #2f3549; color: #fff; padding: 10px; border-radius: 4px; width: 100%; box-sizing: border-box; }
        .btn-submit { background: var(--accent); color: #1a1b26; border: none; padding: 10px 20px; border-radius: 4px; font-weight: bold; cursor: pointer; margin-top: 10px; }
        
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th { text-align: left; color: #565f89; font-size: 0.8rem; padding: 10px; }
        td { padding: 10px; border-bottom: 1px solid #2f3549; }

        .terminal-box { background-color: #15161e; font-family: monospace; padding: 15px; border-radius: 8px; height: 300px; overflow-y: auto; border: 1px solid #1f2335; font-size: 0.8rem; }

        /* Module toggle rows */
        .module-row { display: flex; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 1px solid #2f3549; }
        .module-row:last-child { border-bottom: none; }
        .module-icon { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
        .module-body { flex: 1; }
        .module-title { font-size: 14px; font-weight: 600; color: #c0caf5; }
        .module-desc { font-size: 12px; color: #565f89; margin-top: 2px; }
        .module-end { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
        .mod-badge { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 99px; }
        .mod-badge.on  { background: #1a2e1a; color: #9ece6a; }
        .mod-badge.off { background: #2e1a1a; color: #f7768e; }
        .mod-toggle { width: 40px; height: 22px; background: #2f3549; border: none; border-radius: 99px; position: relative; cursor: pointer; transition: background 0.2s; flex-shrink: 0; outline: none; }
        .mod-toggle.on { background: #9ece6a; }
        .mod-toggle::after { content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #16161e; transition: left 0.2s; }
        .mod-toggle.on::after { left: 21px; }

        /* Banned words */
        .word-chip { display: inline-flex; align-items: center; gap: 6px; background: #2e1a1a; color: #f7768e; border: 1px solid #4a1c1c; border-radius: 99px; padding: 4px 10px; font-size: 12px; margin: 4px; }
        .word-chip form { margin: 0; }
        .word-chip button { background: none; border: none; color: #f7768e; cursor: pointer; font-size: 14px; line-height: 1; padding: 0; }
        .add-word-row { display: flex; gap: 8px; margin-top: 14px; }
        .add-word-row input { flex: 1; }
        .add-word-row .btn-submit { margin-top: 0; }

        /* Error log */
        .terminal-box .err { color: #f7768e; }
        .terminal-box .log { color: #9ece6a; }

        /* Settings link */
        .sidebar-link { display: block; color: var(--text); text-decoration: none; padding: 12px 15px; border-radius: 6px; font-weight: bold; margin-bottom: 5px; transition: 0.2s; }
        .sidebar-link:hover { background: #2f3549; color: var(--accent); }

        @media (max-width: 768px) {
            body { flex-direction: column; }
            .sidebar { width: 100%; height: auto; border-right: none; border-bottom: 1px solid #2f3549; padding: 10px; flex-direction: row; overflow-x: auto; }
            .sidebar h2 { display: none; }
            .tab-btn { margin-bottom: 0; padding: 10px; white-space: nowrap; }
            .main-content { padding: 20px; }
            .grid-stats { grid-template-columns: 1fr; }
            .panel { overflow-x: auto; }
            .module-row { flex-wrap: wrap; }
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <h2>OsQarek's Universe</h2>
        <button class="tab-btn active" onclick="openTab(event, 'dashboard')">⚙️ Configuration</button>
        <button class="tab-btn" onclick="openTab(event, 'modules')">🧩 Modules</button>
        <button class="tab-btn" onclick="openTab(event, 'infractions')">⚖️ Infractions</button>
        <button class="tab-btn" onclick="openTab(event, 'risk-manager')">🛡️ Risk Manager</button>
        <button class="tab-btn" onclick="openTab(event, 'roles')">🎭 Reaction Roles</button>
        <button class="tab-btn" onclick="openTab(event, 'banned-words')">🚫 Banned Words</button>
        <button class="tab-btn" onclick="openTab(event, 'terminal')">🖥️ System Logs</button>
        <div style="margin-top: auto; display: flex; flex-direction: column; gap: 6px;">
            <% if (user && user.id === 'admin') { %>
            <a href="/settings" class="sidebar-link">🔧 Site Settings</a>
            <% } %>
            <a href="/logout" style="color: #f7768e; text-decoration: none; font-weight: bold; padding: 12px 15px;">Logout</a>
        </div>
    </div>

    <div class="main-content">

        <!-- ═══════════════ CONFIGURATION ═══════════════ -->
        <div id="dashboard" class="tab-content active">
            <h2>Dashboard</h2>
            <div class="grid-stats">
                <div class="card-stat"><h3>Status</h3><div class="val" style="color:#9ece6a"><%= stats.botStatus %></div></div>
                <div class="card-stat"><h3>Ping</h3><div class="val"><%= stats.ping %></div></div>
                <div class="card-stat"><h3>Guilds</h3><div class="val"><%= stats.guildsCount %></div></div>
                <div class="card-stat"><h3>Uptime</h3><div class="val" style="font-size:1.1rem;"><%= stats.uptime %></div></div>
            </div>
            <div class="panel">
                <h2>System Settings</h2>
                <form action="/update-settings" method="POST">
                    <label>Welcome Channel ID</label><input name="welcomeChannel" value="<%= settings.welcomeChannel || '' %>">
                    <label style="margin-top:10px; display:block">Goodbye Channel ID</label><input name="goodbyeChannel" value="<%= settings.goodbyeChannel || '' %>">
                    <button type="submit" class="btn-submit">Save Changes</button>
                </form>
            </div>
        </div>

        <!-- ═══════════════ MODULES ═══════════════ -->
        <div id="modules" class="tab-content">
            <h2>🧩 Module Control</h2>
            <p style="color:#565f89; font-size:13px; margin-bottom:20px;">Enable or disable bot feature modules. Changes take effect immediately — no restart required.</p>

            <div class="panel">

                <!-- AI Replies -->
                <div class="module-row">
                    <div class="module-icon" style="background:#1a1f3a;">🤖</div>
                    <div class="module-body">
                        <div class="module-title">AI</div>
                        <div class="module-desc">Controls AI mention replies plus AI-powered slash commands like <code>/summarize</code> and <code>/ask-rules</code>.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.aiEnabled !== false ? 'on' : 'off' %>">
                            <%= db.aiEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;">
                            <input type="hidden" name="module" value="aiEnabled">
                            <button type="submit"
                                    class="mod-toggle <%= db.aiEnabled !== false ? 'on' : '' %>"
                                    title="Toggle AI"
                                    aria-label="Toggle AI"></button>
                        </form>
                    </div>
                </div>

                <!-- Music -->
                <div class="module-row">
                    <div class="module-icon" style="background:#1a2e1a;">🎵</div>
                    <div class="module-body">
                        <div class="module-title">Music</div>
                        <div class="module-desc">Controls the full <code>/music</code> command group: join, play, skip, queue, pause, resume, volume, leave, autoplay, 24/7, and clear.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.musicEnabled !== false ? 'on' : 'off' %>">
                            <%= db.musicEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;">
                            <input type="hidden" name="module" value="musicEnabled">
                            <button type="submit"
                                    class="mod-toggle <%= db.musicEnabled !== false ? 'on' : '' %>"
                                    title="Toggle Music"
                                    aria-label="Toggle Music"></button>
                        </form>
                    </div>
                </div>

                <!-- Modmail -->
                <div class="module-row">
                    <div class="module-icon" style="background:#2e2a1a;">📨</div>
                    <div class="module-body">
                        <div class="module-title">Modmail</div>
                        <div class="module-desc">Relays DMs sent to the bot to the configured mod-log channel with a reply button.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.modmailEnabled !== false ? 'on' : 'off' %>">
                            <%= db.modmailEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;">
                            <input type="hidden" name="module" value="modmailEnabled">
                            <button type="submit"
                                    class="mod-toggle <%= db.modmailEnabled !== false ? 'on' : '' %>"
                                    title="Toggle Modmail"
                                    aria-label="Toggle Modmail"></button>
                        </form>
                    </div>
                </div>

                <!-- Auto-Mod -->
                <div class="module-row">
                    <div class="module-icon" style="background:#2e1a1a;">🚨</div>
                    <div class="module-body">
                        <div class="module-title">Auto-Mod</div>
                        <div class="module-desc">Scans messages for banned words and applies escalation actions automatically.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.automodEnabled !== false ? 'on' : 'off' %>">
                            <%= db.automodEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;">
                            <input type="hidden" name="module" value="automodEnabled">
                            <button type="submit"
                                    class="mod-toggle <%= db.automodEnabled !== false ? 'on' : '' %>"
                                    title="Toggle Auto-Mod"
                                    aria-label="Toggle Auto-Mod"></button>
                        </form>
                    </div>
                </div>

                <!-- Welcome & Goodbye -->
                <div class="module-row">
                    <div class="module-icon" style="background:#1f2030;">👋</div>
                    <div class="module-body">
                        <div class="module-title">Welcome &amp; Goodbye</div>
                        <div class="module-desc">Posts an inverted-colour welcome image and a greyscale goodbye image when members join or leave.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.welcomeEnabled !== false ? 'on' : 'off' %>">
                            <%= db.welcomeEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;">
                            <input type="hidden" name="module" value="welcomeEnabled">
                            <button type="submit"
                                    class="mod-toggle <%= db.welcomeEnabled !== false ? 'on' : '' %>"
                                    title="Toggle Welcome/Goodbye"
                                    aria-label="Toggle Welcome/Goodbye"></button>
                        </form>
                    </div>
                </div>

                <!-- Reminders -->
                <div class="module-row">
                    <div class="module-icon" style="background:#1a1f3a;">⏰</div>
                    <div class="module-body">
                        <div class="module-title">Reminders</div>
                        <div class="module-desc">Controls <code>/reminder</code> and the reminder delivery loop for due reminders.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.remindersEnabled !== false ? 'on' : 'off' %>">
                            <%= db.remindersEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;">
                            <input type="hidden" name="module" value="remindersEnabled">
                            <button type="submit"
                                    class="mod-toggle <%= db.remindersEnabled !== false ? 'on' : '' %>"
                                    title="Toggle Reminders"
                                    aria-label="Toggle Reminders"></button>
                        </form>
                    </div>
                </div>

                <!-- Moderation -->
                <div class="module-row">
                    <div class="module-icon" style="background:#2e1a1a;">⚖️</div>
                    <div class="module-body">
                        <div class="module-title">Moderation</div>
                        <div class="module-desc">Controls moderation actions: <code>/mod</code>, <code>/warn</code>, mute, unmute, slowmode, cases, reaction roles, roles, announcements, and nickname tools.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.moderationEnabled !== false ? 'on' : 'off' %>">
                            <%= db.moderationEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;">
                            <input type="hidden" name="module" value="moderationEnabled">
                            <button type="submit" class="mod-toggle <%= db.moderationEnabled !== false ? 'on' : '' %>" aria-label="Toggle Moderation"></button>
                        </form>
                    </div>
                </div>

                <!-- Utilities -->
                <div class="module-row">
                    <div class="module-icon" style="background:#1a1f3a;">🔧</div>
                    <div class="module-body">
                        <div class="module-title">Utilities</div>
                        <div class="module-desc">Controls general tools: ping, serverinfo, userinfo, pfp, poll, suggest, random, afk, socials, emoji names, and latest-update.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.utilitiesEnabled !== false ? 'on' : 'off' %>">
                            <%= db.utilitiesEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;">
                            <input type="hidden" name="module" value="utilitiesEnabled">
                            <button type="submit" class="mod-toggle <%= db.utilitiesEnabled !== false ? 'on' : '' %>" aria-label="Toggle Utilities"></button>
                        </form>
                    </div>
                </div>

                <!-- Fun -->
                <div class="module-row">
                    <div class="module-icon" style="background:#2e2a1a;">🎲</div>
                    <div class="module-body">
                        <div class="module-title">Fun</div>
                        <div class="module-desc">Controls <code>/fun</code>, ship, and prank commands like ban-prank, keyboard-fix, nuke-server, reset-levels, and nerd-mode.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.funEnabled !== false ? 'on' : 'off' %>">
                            <%= db.funEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;">
                            <input type="hidden" name="module" value="funEnabled">
                            <button type="submit" class="mod-toggle <%= db.funEnabled !== false ? 'on' : '' %>" aria-label="Toggle Fun"></button>
                        </form>
                    </div>
                </div>

                <!-- Quiz -->
                <div class="module-row">
                    <div class="module-icon" style="background:#1a2e1a;">🧠</div>
                    <div class="module-body">
                        <div class="module-title">Quiz</div>
                        <div class="module-desc">Custom quiz creation and trivia games (states, countries, canada) with a leaderboard.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.quizEnabled !== false ? 'on' : 'off' %>">
                            <%= db.quizEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;">
                            <input type="hidden" name="module" value="quizEnabled">
                            <button type="submit" class="mod-toggle <%= db.quizEnabled !== false ? 'on' : '' %>" aria-label="Toggle Quiz"></button>
                        </form>
                    </div>
                </div>

                <!-- Staff Tools -->
                <div class="module-row">
                    <div class="module-icon" style="background:#1a1f3a;">🛠️</div>
                    <div class="module-body">
                        <div class="module-title">Staff Tools</div>
                        <div class="module-desc">Controls staff-only tools: staffstats, syncstats, messagereset, staffdm, ping-all-staff, LOA, strikes, and notes.</div>
                    </div>
                    <div class="module-end">
                        <span class="mod-badge <%= db.staffToolsEnabled !== false ? 'on' : 'off' %>">
                            <%= db.staffToolsEnabled !== false ? 'Enabled' : 'Disabled' %>
                        </span>
                        <form action="/modules/toggle" method="POST" style="display:contents;">
                            <input type="hidden" name="module" value="staffToolsEnabled">
                            <button type="submit" class="mod-toggle <%= db.staffToolsEnabled !== false ? 'on' : '' %>" aria-label="Toggle Staff Tools"></button>
                        </form>
                    </div>
                </div>

            </div>
        </div>

        <!-- ═══════════════ INFRACTIONS ═══════════════ -->
        <div id="infractions" class="tab-content">
            <div class="panel">
                <h2>⚖️ Infraction Database Registry</h2>
                <% if (cases.length === 0) { %> 
                    <p style="color: #565f89;">No records found.</p> 
                <% } else { %>
                    <table>
                        <thead><tr><th>ID</th><th>User</th><th>Type</th><th>Reason</th></tr></thead>
                        <tbody>
                            <% cases.forEach((item, index) => { %>
                            <tr>
                                <td style="color: #7dcfff;">#<%= index %></td>
                                <td><%= item.user || item.userId %></td>
                                <td><strong><%= item.type || 'UNKNOWN' %></strong></td>
                                <td>
                                    <form action="/edit-case/<%= index %>" method="POST" style="display:flex; gap:8px;">
                                        <input type="text" name="reason" value="<%= item.reason %>">
                                        <button type="submit" class="btn-submit" style="margin-top:0;">Update</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>

        <!-- ═══════════════ RISK MANAGER ═══════════════ -->
        <div id="risk-manager" class="tab-content">
            <div class="panel">
                <h2>🛡️ Member Risk Assessment</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Member Tag</th>
                            <th>Risk Score</th>
                            <th>Reason</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (members && members.length > 0) { %>
                            <% members.forEach(member => { %>
                                <% 
                                    let risk = 10;
                                    let reasons = [];
                                    if (member.joinedTimestamp > (Date.now() - 604800000)) { risk += 40; reasons.push("Joined < 7d"); }
                                    const discordEpoch = 1420070400000;
                                    const userId = BigInt(member.id);
                                    const creationTimestamp = Number((userId >> 22n) + BigInt(discordEpoch));
                                    const accountAgeYears = (Date.now() - creationTimestamp) / (1000 * 60 * 60 * 24 * 365);
                                    if (accountAgeYears < 1) { risk += 35; reasons.push("Acct < 1yr"); }
                                    if (!member.user.avatar) { risk += 15; reasons.push("No Avatar"); }
                                %>
                                <tr>
                                    <td><%= member.user.tag %></td>
                                    <td>
                                        <span style="color: <%= risk >= 60 ? '#f7768e' : '#9ece6a' %>;">
                                            <%= risk %>/100 (<%= risk >= 60 ? 'High' : 'Low' %>)
                                        </span>
                                    </td>
                                    <td><%= reasons.length > 0 ? reasons.join(', ') : "Verified Account" %></td>
                                    <td>
                                        <form action="/review-risk/<%= member.id %>" method="POST">
                                            <button type="submit" class="btn-submit">Review</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="4">No members found or intent not enabled.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ═══════════════ REACTION ROLES ═══════════════ -->
        <div id="roles" class="tab-content">
            <div class="panel">
                <h2>🎭 Reaction Role Configuration</h2>
                <form action="/add-reaction-role" method="POST" style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <select name="emoji" style="width: 150px; background: #16161e; color: #fff; padding: 10px; border-radius: 4px; border: 1px solid #2f3549;">
                        <option value="">Select Emoji</option>
                        <% if (typeof emojis !== 'undefined' && emojis && emojis.length > 0) { %>
                            <% emojis.forEach(emoji => { %>
                                <option value="<%= emoji.toString %>"><%= emoji.toString %> :<%= emoji.name %>:</option>
                            <% }) %>
                        <% } else { %>
                            <option value="" disabled>No custom emojis available</option>
                        <% } %>
                    </select>
                    <input name="roleId" placeholder="Role ID" style="flex: 2;">
                    <input name="messageId" placeholder="Message ID" style="flex: 2;">
                    <button type="submit" class="btn-submit" style="margin-top:0;">Add Rule</button>
                </form>
                <% if (reactionRoles && reactionRoles.length > 0) { %>
                <table style="margin-top:20px;">
                    <thead><tr><th>Emoji</th><th>Role ID</th><th>Message ID</th><th>Remove</th></tr></thead>
                    <tbody>
                        <% reactionRoles.forEach((rr, i) => { %>
                        <tr>
                            <td><%= rr.emoji %></td>
                            <td style="color:#7dcfff;"><%= rr.roleId %></td>
                            <td style="color:#565f89;"><%= rr.messageId %></td>
                            <td>
                                <form action="/remove-reaction-role/<%= i %>" method="POST">
                                    <button type="submit" class="btn-submit" style="background:#f7768e; margin-top:0; padding:6px 12px;">✕</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>

        <!-- ═══════════════ BANNED WORDS ═══════════════ -->
        <div id="banned-words" class="tab-content">
            <div class="panel">
                <h2>🚫 Banned Words</h2>
                <p style="color:#565f89; font-size:13px; margin-bottom:16px;">Words removed here take effect on the next message scan. Auto-Mod must be enabled for deletions to occur.</p>
                <div>
                    <% if (bannedWords && bannedWords.length > 0) { %>
                        <% bannedWords.forEach(word => { %>
                        <span class="word-chip">
                            <%= word %>
                            <form action="/banned-words/remove" method="POST">
                                <input type="hidden" name="word" value="<%= word %>">
                                <button type="submit" title="Remove">✕</button>
                            </form>
                        </span>
                        <% }) %>
                    <% } else { %>
                        <p style="color:#565f89;">No banned words configured.</p>
                    <% } %>
                </div>
                <div class="add-word-row">
                    <form action="/banned-words/add" method="POST" style="display:flex; gap:8px; width:100%;">
                        <input name="word" placeholder="Add a word or phrase…" style="flex:1;">
                        <button type="submit" class="btn-submit" style="margin-top:0;">Add</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- ═══════════════ SYSTEM LOGS ═══════════════ -->
        <div id="terminal" class="tab-content">
            <div class="panel">
                <h2>🖥️ Live System Logs</h2>
                <div class="terminal-box">
                    <% logs.slice().reverse().forEach(log => { %>
                    <div class="log">[<%= log.time %>] <%= log.text %></div>
                    <% }) %>
                </div>
            </div>
            <% if (errors && errors.length > 0) { %>
            <div class="panel">
                <h2>❌ Error Log</h2>
                <div class="terminal-box">
                    <% errors.slice().reverse().forEach(err => { %>
                    <div class="err">[<%= err.time %>] <%= err.text %></div>
                    <% }) %>
                </div>
            </div>
            <% } %>
        </div>

    </div><!-- /main-content -->

    <script>
        function openTab(evt, tabId) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            if (evt && evt.currentTarget) {
                evt.currentTarget.classList.add('active');
            } else {
                const btn = document.querySelector(`.tab-btn[onclick*="${tabId}"]`);
                if (btn) btn.classList.add('active');
            }
            window.location.hash = tabId;
        }

        window.addEventListener('load', () => {
            const hash = window.location.hash.substring(1);
            if (hash && document.getElementById(hash)) {
                openTab(null, hash);
            }
        });
    </script>
</body>
</html>
