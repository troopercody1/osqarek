<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Account security</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:wght@400..700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Figtree', 'Segoe UI', system-ui, sans-serif; background-color: #0f0d27; color: #d6d2f5; padding: 40px 20px; }
        .page { max-width: 880px; margin: 0 auto; }
        a { color: #a58bff; text-decoration: none; } a:hover { color: #8ecbff; }
        a.back { font-size: 13px; display: inline-flex; gap: 6px; margin-bottom: 24px; }
        h1 { color: #a58bff; font-size: 22px; font-weight: 600; margin-bottom: 4px; }
        .page-sub { font-size: 13px; color: #8f8abf; margin-bottom: 20px; }
        .flash { padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 18px; border: 1px solid; }
        .flash.ok  { background: rgba(158,206,106,.1); color: #5fe3a1; border-color: #5fe3a1; }
        .flash.bad { background: rgba(255,107,138,.1); color: #ff6b8a; border-color: #ff6b8a; }
        .card { background: #171337; border: 1px solid #2a2561; border-radius: 12px; overflow: hidden; margin-bottom: 18px; }
        .pad { padding: 18px; }
        .toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
        .toolbar form { display: flex; gap: 8px; flex: 1; min-width: 220px; }
        input[type=text], select, textarea { background: #171337; border: 1px solid #2a2561; color: #f3f1ff; padding: 8px 10px; border-radius: 6px; width: 100%; font-family: 'Figtree', 'Segoe UI', system-ui, sans-serif; font-size: 13px; }
        select { width: auto; }
        textarea { min-height: 150px; resize: vertical; line-height: 1.5; }
        input:focus, textarea:focus, select:focus { outline: none; border-color: #a58bff; }
        .btn { font-size: 13px; font-weight: 500; padding: 7px 14px; border-radius: 6px; border: 1px solid #2a2561; background: #171337; color: #f3f1ff; cursor: pointer; font-family: 'Figtree', 'Segoe UI', system-ui, sans-serif; white-space: nowrap; display: inline-block; }
        .btn:hover { background: #252636; color: #f3f1ff; }
        .btn-primary { background: #7c4dff; color: #fff; border-color: transparent; } .btn-primary:hover { background: #6a3df0; color: #fff; }
        .btn-solve { background: #0f2c22; color: #5fe3a1; border-color: #2c4a2c; } .btn-solve:hover { background: #213a21; color: #5fe3a1; }
        .btn.active { border-color: #a58bff; color: #a58bff; }
        .pill { font-size: 11px; font-weight: 600; padding: 2px 9px; border-radius: 99px; white-space: nowrap; }
        .st-open { background: #211a52; color: #a58bff; } .st-awaiting { background: #33290f; color: #ffc857; } .st-solved { background: #0f2c22; color: #5fe3a1; }
        .row { display: flex; align-items: center; gap: 14px; padding: 13px 16px; border-bottom: 1px solid #2a2561; color: inherit; }
        .row:last-child { border-bottom: none; } .row:hover { background: #1e1a45; }
        .row-main { flex: 1; min-width: 0; }
        .row-subj { font-size: 13.5px; color: #f3f1ff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .row-sub { font-size: 12px; color: #8f8abf; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .row-end { text-align: right; flex-shrink: 0; font-size: 11px; color: #8f8abf; line-height: 1.6; }
        .needs .row-subj { font-weight: 600; }
        .empty { padding: 28px; text-align: center; font-size: 13px; color: #8f8abf; }
        .head { display: flex; gap: 12px; align-items: flex-start; flex-wrap: wrap; margin-bottom: 14px; }
        .head h1 { flex: 1; min-width: 240px; color: #f3f1ff; font-size: 19px; }
        .meta { display: grid; grid-template-columns: 110px 1fr; gap: 6px 14px; font-size: 12.5px; padding: 16px 18px; }
        .meta dt { color: #8f8abf; } .meta dd { color: #d6d2f5; word-break: break-word; }
        .msg { padding: 16px 18px; border-bottom: 1px solid #2a2561; }
        .msg:last-child { border-bottom: none; }
        .msg.staff { background: #1c1e2e; }
        .msg-top { font-size: 12px; color: #8f8abf; margin-bottom: 8px; display: flex; gap: 8px; align-items: center; }
        .msg-top b { color: #f3f1ff; font-weight: 600; font-size: 13px; }
        .tag { font-size: 10px; padding: 1px 7px; border-radius: 99px; background: #211a52; color: #a58bff; }
        .msg-body { white-space: pre-wrap; word-wrap: break-word; overflow-wrap: anywhere; font-size: 13.5px; line-height: 1.6; color: #f3f1ff; }
        .event { text-align: center; font-size: 11.5px; color: #8f8abf; padding: 10px; border-bottom: 1px solid #2a2561; }
        label { font-size: 12px; color: #8f8abf; display: block; margin: 0 0 6px; }
        .reply-actions { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; align-items: center; }
        .small { font-size: 12px; color: #8f8abf; line-height: 1.6; }
        .warn { background: rgba(224,175,104,.08); border: 1px solid #5a4a28; color: #ffc857; border-radius: 8px; padding: 9px 12px; font-size: 12.5px; margin-bottom: 14px; }
        h1, h2, h3 { font-family: 'Bricolage Grotesque', 'Segoe UI', system-ui, sans-serif; letter-spacing: -.01em; }
    :focus-visible { outline: 2px solid #ffc857; outline-offset: 2px; }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; scroll-behavior: auto !important; } }

        .pill-lock { background: rgba(255,107,138,.12); color: #ff6b8a; } .pill-ok { background: #0f2c22; color: #5fe3a1; } .pill-warn { background: #33290f; color: #ffc857; }
        .acct { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-bottom: 1px solid #2a2561; flex-wrap: wrap; }
        .acct:last-child { border-bottom: none; }
        .acct form { margin: 0; }
        .btn-danger { background: rgba(255,107,138,.1); color: #ff6b8a; border-color: #5a2a38; } .btn-danger:hover { background: rgba(255,107,138,.2); color: #ff6b8a; }
        h2 { font-size: 15px; color: #f3f1ff; margin: 26px 0 10px; }
    </style>
</head>
<body>
<div class="page">
    <a href="/settings" class="back">&larr; Settings</a>
    <h1>Account security</h1>
    <p class="page-sub">Owners only. A login locks after 3 failed password attempts and stays locked until it is unlocked here, with <code>/security unlock</code> in Discord, or (if enabled) with a code DM'd to its owner.</p>

    <% if (msg) { %><div class="flash ok"><%= msg %></div><% } %>
    <% if (err) { %><div class="flash bad"><%= err %></div><% } %>

    <h2>Staff logins</h2>
    <div class="card">
        <% accounts.forEach(function (a) { %>
        <div class="acct">
            <div class="row-main">
                <div class="row-subj"><b><%= a.username %></b><%= a.isSelf ? ' (you)' : '' %> &middot; <%= a.rank %></div>
                <div class="row-sub">
                    Discord: <%= a.discordId ? a.discordId : 'not linked (no DMs / no code unlock)' %>
                    &middot; Failed attempts: <%= a.failed %>/<%= a.maxFailed %>
                    <% if (a.lastFailedAt) { %>&middot; last <%= new Date(a.lastFailedAt).toLocaleString('en-GB') %> (IP <%= a.lastFailedIp || 'unknown' %>)<% } %>
                </div>
                <% if (a.locked) { %>
                <div class="row-sub" style="white-space:normal;">
                    Locked <%= a.lockedAt ? new Date(a.lockedAt).toLocaleString('en-GB') : '' %> by <%= a.lockedBy || 'System' %> &mdash; <%= a.lockedReason || 'no reason' %>
                </div>
                <% } %>
            </div>
            <% if (a.locked) { %>
                <span class="pill pill-lock">Locked</span>
                <% if (a.otpBlocked) { %><span class="pill pill-warn" title="3 wrong codes were entered">Code unlock off</span><% } %>
                <form action="/settings/security/unlock" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= a.id %>"><button class="btn btn-solve" type="submit">Unlock</button></form>
            <% } else { %>
                <span class="pill pill-ok">Active</span>
                <% if (!a.isSelf) { %>
                <form action="/settings/security/lock" method="POST" onsubmit="return confirm('Lock <%= a.username.replace(/[^A-Za-z0-9_.-]/g, '') %>? They will not be able to log in until you unlock them.');"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= a.id %>"><button class="btn btn-danger" type="submit">Lock</button></form>
                <% } %>
            <% } %>
        </div>
        <% }) %>
    </div>

    <h2>Blocked IPs</h2>
    <div class="card">
        <% if (!blocks.length) { %>
        <div class="empty">No IPs are blocked right now.</div>
        <% } else { blocks.forEach(function (b) { %>
        <div class="acct">
            <div class="row-main">
                <div class="row-subj"><code><%= b.ip %></code></div>
                <div class="row-sub"><%= b.reason %> &middot; until <%= new Date(b.until).toLocaleString('en-GB') %></div>
            </div>
            <form action="/settings/security/unblock" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="ip" value="<%= b.ip %>"><button class="btn" type="submit">Unblock</button></form>
        </div>
        <% }) } %>
    </div>

    <p class="small">Unlocking with a Discord code is <b><%= otpEnabled ? 'on' : 'off' %></b> (<code>SECURITY_OTP_UNLOCK</code>). It allows 3 wrong codes, then that login needs unlocking from here or by the support team.</p>
</div>
</body>
</html>
