<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Maintenance Mode</title>
    <style>
        body { font-family: 'Figtree', 'Segoe UI', system-ui, sans-serif; background-color: #0f0d27; color: #d6d2f5; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; text-align: center; }
        .card { background-color: #171337; padding: 40px; border-radius: 12px; border: 1px solid #2a2561; max-width: 350px; }
        h1 { color: #ff6b8a; margin-bottom: 20px; }
        p { margin-bottom: 30px; }
        
        .btn-admin {
            background-color: transparent;
            color: #d6d2f5;
            padding: 12px 24px;
            border-radius: 6px;
            border: 1px solid #8f8abf;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
            transition: all 0.2s;
            width: 100%;
            box-sizing: border-box;
        }
        .btn-admin:hover {
            background-color: #1a1640;
            color: #f3f1ff;
            border-color: #a58bff;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1>🚧 Maintenance Mode</h1>
        
        <p>The dashboard is currently offline for updates. Please check back later.</p>
        
        <% if (settings && settings.maintenanceETA) { %>
            <p style="color: #a58bff; font-weight: bold;">
                Estimated Return: <%= settings.maintenanceETA %>
            </p>
        <% } %>
        
        <a href="/auth/admin" class="btn-admin">Login as Administrator</a>
    </div>
</body>
</html>
