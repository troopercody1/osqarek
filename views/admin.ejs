<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Authentication</title>
    <style>
        body { 
            font-family: 'Figtree', 'Segoe UI', system-ui, sans-serif; 
            background-color: #0f0d27; 
            color: #d6d2f5; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; 
            margin: 0;
            padding: 20px; 
        }
        .login-card { 
            background-color: #171337; 
            padding: 40px; 
            border-radius: 12px; 
            border: 1px solid #2a2561; 
            text-align: center; 
            width: 100%; 
            max-width: 350px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        h2 { color: #a58bff; margin-bottom: 20px; margin-top: 0; }
        
        .error-msg { background-color: rgba(255, 107, 138, 0.1); color: #ff6b8a; border: 1px solid #ff6b8a; padding: 10px; border-radius: 6px; margin-bottom: 20px; font-size: 0.9rem; }
        .success-msg { background-color: rgba(158, 206, 106, 0.1); color: #5fe3a1; border: 1px solid #5fe3a1; padding: 10px; border-radius: 6px; margin-bottom: 20px; font-size: 0.9rem; }

        .btn-success { 
            background-color: #5fe3a1; 
            color: #171337; 
            padding: 12px; 
            border: none; 
            border-radius: 6px; 
            font-weight: bold; 
            cursor: pointer; 
            width: 100%;
            font-size: 1rem;
            transition: opacity 0.2s;
        }
        .btn-success:hover { opacity: 0.9; }

        input[type="text"],
        input[type="password"] {
            width: 100%;
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #8f8abf;
            background: #0f0d27;
            color: white;
            margin-bottom: 15px;
            box-sizing: border-box;
            font-size: 1rem;
            text-align: center;
            letter-spacing: 2px;
        }
        input[type="text"]:focus,
        input[type="password"]:focus { outline: none; border-color: #a58bff; }

        .back-link { color: #8f8abf; font-size: 0.85rem; text-decoration: none; display: inline-block; margin-top: 20px; transition: color 0.2s; }
        .back-link:hover { color: #d6d2f5; }
    </style>
</head>
<body>

    <div class="login-card">
        <h2>Admin Authentication</h2>
        
        <% if (error) { %> <div class="error-msg"><%= error %></div> <% } %>
        <% if (msg) { %> <div class="success-msg"><%= msg %></div> <% } %>

        <form action="/auth/verify-admin" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="username" placeholder="Username" required autocomplete="off" autocapitalize="off" style="text-align:left; letter-spacing:normal;">
            <input type="password" name="password" placeholder="Enter password" required autocomplete="off">
            <button type="submit" class="btn-success">Verify & Login</button>
        </form>
        
        <a href="/login" class="back-link">← Back to Main Login</a>
    </div>

</body>
</html>
