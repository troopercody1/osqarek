<div class="history-panel">
    <h2>📜 Infraction History for <%= userId %></h2>

    <table class="history-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Type</th>
                <th>Reason</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody>
            <% history.forEach(item => { %>
            <tr>
                <td>#<%= item.id %></td>
                <td class="type-<%= item.type %>"><%= item.type %></td>
                <td><%= item.reason %></td>
                <td><%= item.timestamp %></td>
            </tr>
            <% }) %>
        </tbody>
    </table>

    <a href="/#infractions" class="back-link">← Back to Infractions</a>
</div>
